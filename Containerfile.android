# BŁĄD ZŁAPANY NA LINKOWANIU (21. przypadek, BEZPOŚREDNIA konsekwencja
# dwudziestego -- `ld.lld: undefined symbol: prefs::kSigninAllowed`.
# Przywrócona w 20. przypadku deklaracja/rejestracja jest poprawna i
# kompiluje się -- ale sama DEFINICJA stałej (`components/signin/public/
# base/signin_pref_names.cc`, `const char kSigninAllowed[] =
# "signin.allowed";`) nigdy się nie kompiluje, bo `remove-unused-
# preferences-fields.patch` usuwa `signin_pref_names.cc`/`.h` z listy
# `sources` targetu `component("signin_switches")` w `components/signin/
# public/base/BUILD.gn` -- TEN SAM wzorzec co szesnasty przypadek
# (target przestaje kompilować plik z definicjami), tylko tu przez
# usunięcie z listy `sources`, nie zamianę całego targetu na pusty
# `group()`. Sama treść `signin_pref_names.cc` NIE jest dotknięta przez
# żaden patch (proste, samodzielne stałe `extern const char[]`, jedyna
# zależność to `build/build_config.h`) -- wystarczy przywrócić dwie
# linie w `sources`, nie trzeba nic więcej. Zweryfikowane host-side na w
# pełni załatanym drzewie.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cd /srcbuild && \
    F=components/signin/public/base/BUILD.gn && \
    (grep -q '"signin_pref_names.cc",' "$F" || \
     (grep -q '"signin_switches.cc",' "$F" && \
      sed -i 's|    "signin_switches.cc",|    "signin_pref_names.cc",\n    "signin_pref_names.h",\n    "signin_switches.cc",|' "$F")) && \
    grep -q '"signin_pref_names.cc",' "$F" || \
        (echo "BŁĄD: fix signin_pref_names.cc (sources) się nie zaaplikował" && exit 1)

# BŁĄD ZŁAPANY W NINJA (14. przypadek, 96% -- 58067/60700, najdalej dotąd)
# -- TA SAMA rodzina co is_android-untested (pierwszy wzorzec z tej sesji),
# tym razem w kodzie Android-specyficznym poza `extensions`:
# `chrome/browser/android/rlz/rlz_ping_handler.cc` (RLZ = mechanizm
# śledzenia "skąd pochodzi ta instalacja Chrome", jeden z klasycznych
# celów ungoogled-chromium) używa `rlz_lib::kFinancialServer` --
# `core/ungoogled-chromium/disable-untraceable-urls.patch` USUWA tę
# stałą całkowicie z `rlz/lib/lib_values.{cc,h}` i podmienia JEDYNE
# znane mu użycie (`rlz/lib/financial_ping.cc`, desktop) na literał
# `"about:blank"` -- ale `rlz_ping_handler.cc` (JNI bridge dla
# ANDROIDOWEGO UI RLZ, `chrome/browser/android/rlz/`, zupełnie inna
# ścieżka kodu niż desktopowy `financial_ping.cc`) ma WŁASNE użycie tej
# samej stałej, którego autor patcha nie dotknął (nie buduje na
# Androida). Efekt: `no member named 'kFinancialServer' in namespace
# 'rlz_lib'`. Fix: dokładnie ten sam wzorzec co patch zastosował na
# desktopie -- podmień na `"about:blank"` (deaktywacja URL-a ping,
# spójna z całym sensem tego patcha), nie próbuj przywracać usuniętej
# stałej. Zweryfikowane host-side: linia istnieje dokładnie raz,
# `rlz_lib::kFinancialPingPath` (osobna stała, ścieżka URL-a, nie host)
# zostaje nietknięta.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cd /srcbuild && \
    F=chrome/browser/android/rlz/rlz_ping_handler.cc && \
    (grep -q '"https://%s%s?", "about:blank", rlz_lib::kFinancialPingPath' "$F" || \
     (grep -q '"https://%s%s?", rlz_lib::kFinancialServer, rlz_lib::kFinancialPingPath' "$F" && \
      sed -i 's|"https://%s%s?", rlz_lib::kFinancialServer, rlz_lib::kFinancialPingPath|"https://%s%s?", "about:blank", rlz_lib::kFinancialPingPath|' "$F")) && \
    grep -q '"https://%s%s?", "about:blank", rlz_lib::kFinancialPingPath' "$F" || \
        (echo "BŁĄD: fix rlz_ping_handler.cc (kFinancialServer) się nie zaaplikował" && exit 1)

# ==============================================================================
# 5e. WARIANT UTWARDZONY: dopełniające literały -- to, czego patche ungoogled NIE robią
# ==============================================================================
#     Wcześniejsza wersja tej sekcji miała 11 literałów (patrz historia
#     gita, commit f5445fb) -- po wdrożeniu pełnej serii patchy ungoogled
#     (5d wyżej) **7 z nich okazało się zdublowanych albo w konflikcie**,
#     zweryfikowane EMPIRYCZNIE (host-side, próba każdego sed-a na
#     już-załatanym drzewie), nie zgadywane:
#       - podpowiedzi wyszukiwania, strony błędów Google, autofill karty,
#         autofill adresy, dostęp do form płatności, menedżer haseł
#         (`kCredentialsEnableService`) -- wszystkie już ustawione przez
#         `extra/inox-patchset/0006-modify-default-prefs.patch`
#       - tryb DNS -- już ustawiony przez `core/ungoogled-chromium/
#         doh-changes.patch` (dokładnie ten sam `SecureDnsMode::kOff`)
#       - logowanie do konta (`kSigninAllowed`) -- literał zniknął całkiem,
#         `remove-unused-preferences-fields.patch` przebudował
#         `primary_account_manager.cc`; ungoogled blokuje logowanie
#         szerzej (m.in. `disable-gaia.patch`), więc pojedynczy pref był
#         tu niepotrzebny
#     Zostają 4 literały, których patche ungoogled nie dotykają (zweryfikowane
#     że nadal się aplikują na już-załatanym drzewie):
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then echo "==> Wariant ${VARIANT}: zbędne"; exit 0; fi; \
    cd /srcbuild && \
    (grep -q "kSafeBrowsingEnabled, false," components/safe_browsing/core/common/safe_browsing_prefs.cc || \
     (grep -q "kSafeBrowsingEnabled, true," components/safe_browsing/core/common/safe_browsing_prefs.cc && \
      sed -i 's/kSafeBrowsingEnabled, true,/kSafeBrowsingEnabled, false,/' \
          components/safe_browsing/core/common/safe_browsing_prefs.cc)) && \
    grep -q "kSafeBrowsingEnabled, false," components/safe_browsing/core/common/safe_browsing_prefs.cc || \
        (echo "BŁĄD: domyślna wartość Safe Browsing się nie zmieniła" && exit 1)

RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cd /srcbuild && \
    (grep -q "NetworkPredictionOptions::kDisabled)" chrome/browser/preloading/preloading_prefs.cc || \
     (grep -q "static_cast<int>(NetworkPredictionOptions::kDefault)" chrome/browser/preloading/preloading_prefs.cc && \
      sed -i 's/static_cast<int>(NetworkPredictionOptions::kDefault)/static_cast<int>(NetworkPredictionOptions::kDisabled)/' \
          chrome/browser/preloading/preloading_prefs.cc)) && \
    grep -q "NetworkPredictionOptions::kDisabled)" chrome/browser/preloading/preloading_prefs.cc || \
        (echo "BŁĄD: domyślna wartość prefetchu sieciowego się nie zmieniła" && exit 1)

# Tylko wykrywanie wycieków haseł -- kCredentialsEnableService w tym samym
# pliku już ustawione przez patch inox (patrz komentarz wyżej).
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cd /srcbuild && \
    (grep -q "kPasswordLeakDetectionEnabled, false," components/password_manager/core/browser/password_manager.cc || \
     (grep -q "kPasswordLeakDetectionEnabled, true," components/password_manager/core/browser/password_manager.cc && \
      sed -i 's/kPasswordLeakDetectionEnabled, true,/kPasswordLeakDetectionEnabled, false,/' \
          components/password_manager/core/browser/password_manager.cc)) && \
    grep -q "kPasswordLeakDetectionEnabled, false," components/password_manager/core/browser/password_manager.cc || \
        (echo "BŁĄD: domyślna wartość wykrywania wycieków haseł się nie zmieniła" && exit 1)

# Do Not Track -- KIERUNEK ODWROTNY niż reszta: domyślnie jest false
# (wyłączone), my chcemy true (włączone).
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cd /srcbuild && \
    (grep -q "kEnableDoNotTrack, true," chrome/browser/ui/browser_ui_prefs.cc || \
     (grep -q "kEnableDoNotTrack, false," chrome/browser/ui/browser_ui_prefs.cc && \
      sed -i 's/kEnableDoNotTrack, false,/kEnableDoNotTrack, true,/' \
          chrome/browser/ui/browser_ui_prefs.cc)) && \
    grep -q "kEnableDoNotTrack, true," chrome/browser/ui/browser_ui_prefs.cc || \
        (echo "BŁĄD: domyślna wartość Do Not Track się nie zmieniła" && exit 1)

# AICore Prompt API (most do systemowego Gemini Nano przez Google Play
# Services) -- ModelBrokerAndroid tworzy go jako globalny singleton przy
# KAŻDYM starcie Chrome na Androidzie (optimization_guide_global_state.cc,
# gałąź IS_ANDROID), niezależnie od jakiejkolwiek flagi GN. Kluczowa flaga
# `kAICorePrompt` (components/optimization_guide/core/model_execution/
# android/model_broker_android.cc) jest zdefiniowana DWA RAZY w bloku
# #if/#else BUILDFLAG(GOOGLE_CHROME_BRANDING) -- w gałęzi #else (czyli w
# KAŻDYM niebrandowanym buildzie, w tym naszym) jest ENABLED_BY_DEFAULT.
# Żadna z 39 flag GN, żaden z 106 patchy ungoogled, żaden z 4 pozostałych
# literałów sekcji 5e tego nie dotyka -- zweryfikowane grepem po całym
# drzewie (audyt AI/ML, sesja 2026-08-08).
#
# Zweryfikowane host-side PRZED wdrożeniem, że kierunek ENABLED->DISABLED
# jest bezpieczny: jedyne odwołania do `kAICorePrompt` w całym drzewie to
# warunkowe `base::FeatureList::IsEnabled(features::kAICorePrompt)` w
# `GetAICoreFeatureFor()`, które przy fladze wyłączonej po prostu zwraca
# `std::nullopt` -- DOKŁADNIE ta sama ścieżka kodu, którą
# `kAICoreScamDetection` (sąsiednia flaga, już DISABLED_BY_DEFAULT w tej
# samej gałęzi #else) przechodzi już dziś w normalnej pracy. Brak
# CHECK/DCHECK zakładającego włączony stan. Fix NIE rusza gałęzi
# `#if BUILDFLAG(GOOGLE_CHROME_BRANDING)` (nieużywanej w tym buildzie) ani
# `kAICoreScamDetection` (już poprawnie DISABLED w gałęzi #else).
#
# Kotwica sed ograniczona zakresem `/^#else$/,/^#endif$/` (plik ma
# dokładnie jeden nieindentowany blok #if/#else/#endif) -- bez tego prosty
# `grep`/`sed` po samym tekście `FEATURE_DISABLED_BY_DEFAULT` dawałby
# fałszywy pozytyw idempotencji już przy PIERWSZYM uruchomieniu, bo gałąź
# #if ma tę wartość od zawsze (dla kAICorePrompt) -- ten sam wzorzec błędu
# co odwrócony warunek `!=`/`=` w sekcji 5d.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then echo "==> Wariant ${VARIANT}: pomijam fix kAICorePrompt"; exit 0; fi; \
    cd /srcbuild && \
    F=components/optimization_guide/core/model_execution/android/model_broker_android.cc && \
    (grep -A1 '^#else$' "$F" | grep -q 'BASE_FEATURE(kAICorePrompt, base::FEATURE_DISABLED_BY_DEFAULT);' || \
     (grep -A1 '^#else$' "$F" | grep -q 'BASE_FEATURE(kAICorePrompt, base::FEATURE_ENABLED_BY_DEFAULT);' && \
      sed -i '/^#else$/,/^#endif$/{s/BASE_FEATURE(kAICorePrompt, base::FEATURE_ENABLED_BY_DEFAULT);/BASE_FEATURE(kAICorePrompt, base::FEATURE_DISABLED_BY_DEFAULT);/}' "$F")) && \
    grep -A1 '^#else$' "$F" | grep -q 'BASE_FEATURE(kAICorePrompt, base::FEATURE_DISABLED_BY_DEFAULT);' || \
        (echo "BŁĄD: domyślna wartość AICore Prompt API (kAICorePrompt) się nie zmieniła" && exit 1)

# ==============================================================================
# 5f. WARIANT UTWARDZONY: domain_substitution -- ta sama technika co desktop
# ==============================================================================
#     Analogicznie do desktopowego Containerfile (krok 7): podmiana domen
#     Google/Chrome/YouTube/gstatic itd. na nieistniejące (google.com ->
#     9oo91e.qjz9zk) w CAŁYM drzewie źródeł, tekstowo -- nie tylko flagi
#     wyłączające podsystemy (39 flag GN wyżej), literały (5e) ani patche
#     (5d), tylko każde wystąpienie znanej domeny w plikach, które
#     ungoogled-chromium audytował. Klon z sekcji 5d ponownie użyty --
#     ten sam `/repo/ungoogled-domsub` ma listy domain_substitution.
#
#     Mechanizm: `domain_regex.list` (21 generycznych wzorców tekstowych,
#     niezależnych od platformy) + `domain_substitution.list` (17745 ścieżek
#     plików, które ungoogled zweryfikował jako zawierające dopasowania).
#     Brakująca ścieżka NIE jest błędem -- skrypt cicho pomija (`Skipping
#     non-existent path`, zweryfikowane w źródle
#     `utils/domain_substitution.py:220-223`), więc różnice między drzewem
#     desktopowym a Android (submoduły, pliki Java) są bezpieczne.
#
#     ZWERYFIKOWANE PRZED WDROŻENIEM (host-side, bez kontenera): z 17745
#     ścieżek na liście 11168 istnieje w drzewie Android i KAŻDA miała
#     realną podmianę (zero no-opów) -- próbny `apply`+`revert` przeszedł
#     czysto (exit 0), diff po revercie 0 linii różnicy w treści plików.
#
#     LUKA WYKRYTA I DOMKNIĘTA WŁASNYM AUDYTEM (nie zgadywana): lista
#     ungoogled jest audytowana pod desktop, więc pomija pliki specyficzne
#     dla Androida (Java/XML), które NIE mają desktopowego odpowiednika.
#     Przeskanowano katalogi `chrome/android`, `ui/android`,
#     `content/public/android`, `android_webview`, `build/android` tymi
#     samymi 21 wzorcami regex -- 68 plików PRODUKCYJNYCH (poza testami/
#     dokumentacją/skryptami builda) miało dopasowanie, którego nie było na
#     liście ungoogled. Każde sprawdzone ręcznie -- prawdziwe domeny, nie
#     fałszywe trafienia, m.in.:
#       - `RequestGenerator.java`: `update.googleapis.com` (serwer Omaha,
#         auto-update Chrome na Androidzie)
#       - `ConnectivityDetector.java`: `www.google.com/generate_204` i
#         `connectivitycheck.gstatic.com` (ping wprost do Google przy
#         KAŻDEJ zmianie sieci, poza jakąkolwiek stroną)
#       - `GoogleWalletLauncher.java`, `ChromeStringConstants.java`:
#         wallet.google.com, payments.google.com, chrome.google.com/data
#     Lista tych 68 ścieżek: `android_domain_substitution_extra.list`
#     (własna, wersjonowana w tym repo -- NIE część ungoogled-chromium).
#     Od 156 (2026-10-26) 67 ścieżek: 4 pliki przeniesione upstream (Omaha
#     do chrome/browser/omaha/android/, SyncSettingsUtils do
#     chrome/browser/sync/android/), AttributionOsLevelManager.java usunięty.
#     `domain_substitution.py` pomija brakujące ścieżki PO CICHU, więc krok
#     niżej przerywa build, gdy którejkolwiek z naszych ścieżek brakuje --
#     inaczej każde podbicie wersji mogłoby bez śladu zdjąć podmianę domen
#     z przeniesionego pliku.
#     Doklejona do listy ungoogled przed jednym wspólnym przebiegiem
#     `apply` (te same 21 wzorców regex -- generyczne, nie desktop-specific).
#
#     Guard `VARIANT=ungoogled`: wariant `vanilla` (czyste Chromium, bez
#     żadnych patchy) nie ma po co dostawać domain_substitution -- to
#     osobny, izolowany test "czy sam pipeline i wersja Chromium są zdrowe",
#     nie kolejny poziom prywatności.
COPY android_domain_substitution_extra.list /repo/android_domain_substitution_extra.list

# WYKLUCZENIE (znalezione przy pierwszym realnym buildzie, nie zgadywane):
# `components/safe_browsing/content/resources/real_time_url_checks_allowlist/
# validation_utils.py` jest na liście ungoogled, ale jego jedyna rola to
# sanity-check przy KOMPILACJI -- liczy sha256("youtube.com/") i sprawdza,
# czy ten hash istnieje w NIEPODMIENIONYCH danych `real_time_url_allowlist.
# asciipb` (ten plik danych NIE jest na liście ungoogled -- zawiera surowe
# prefiksy hashy, nie tekst). Po podmianie stringu w validation_utils.py na
# "y0u1ub3.qjz9zk/" hash przestaje pasować do (nadal prawdziwych) danych ->
# `AssertionError: Bad url_hashes`. Akcja budująca to sprawdzenie
# (`make_real_time_url_allowlist_protobuf`, components/safe_browsing/
# content/resources/real_time_url_checks_allowlist/BUILD.gn) jest zagadkowo
# gałęziowana `if (is_android && safe_browsing_mode == 2)` -- WYŁĄCZNIE
# Android, nigdy desktop -- dlatego ungoogled-chromium (tylko desktop)
# nigdy na to nie trafił, mimo że plik jest na ich liście. To nie błąd ich
# listy, tylko luka, której nie mieli jak zauważyć. Wykluczamy tylko TEN
# plik (sam plik nie zawiera nic wartego podmiany poza tym jednym
# stringiem-kanarkiem) -- reszta listy ungoogled zostaje bez zmian.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    MISSING=$(while read -r f || [ -n "$f" ]; do [ -z "$f" ] || [ -e "/srcbuild/$f" ] || echo "  $f"; done < /repo/android_domain_substitution_extra.list) && \
    if [ -n "${MISSING}" ]; then \
        echo "BŁĄD: tych ścieżek z android_domain_substitution_extra.list nie ma w tej wersji Chromium (przeniesione albo usunięte upstream)."; \
        echo "${MISSING}"; \
        echo "domain_substitution pominęłoby je PO CICHU (tylko 'Skipping non-existent path'), a pliki z domenami Google straciłyby podmianę. Popraw listę."; \
        exit 1; \
    fi && \
    grep -v '^components/safe_browsing/content/resources/real_time_url_checks_allowlist/validation_utils\.py$' \
        /repo/ungoogled-domsub/domain_substitution.list > /repo/domain_substitution_ungoogled_filtered.list && \
    sort -u /repo/domain_substitution_ungoogled_filtered.list /repo/android_domain_substitution_extra.list \
        > /repo/domain_substitution_combined.list && \
    echo "==> domain_substitution: $(wc -l < /repo/domain_substitution_combined.list) ścieżek (ungoogled + $(wc -l < /repo/android_domain_substitution_extra.list) własnych Android, minus 1 wykluczenie)" && \
    cd /repo/ungoogled-domsub && \
    python3 utils/domain_substitution.py apply \
        -r domain_regex.list \
        -f /repo/domain_substitution_combined.list \
        /srcbuild && \
    if grep -q "connectivitycheck.gstatic.com" \
        /srcbuild/chrome/android/java/src/org/chromium/chrome/browser/net/connectivitydetector/ConnectivityDetector.java; then \
        echo "BŁĄD: domain_substitution nie podmieniło znanego przykładu (ConnectivityDetector.java)" && exit 1; \
    fi

# BŁĄD ZŁAPANY W `gn gen` (156.0.8078.47, 2026-10-26 -- wzorzec:
# ungoogled nie testuje Androida). Patch ungoogled `extra/ungoogled-chromium/
# enable-extra-locales.patch` usuwa z build/config/locales.gni blok, który na
# Androidzie robił `extended_locales -= _non_android_locales` (czyli wyjmował
# "cy", walijski) -- więc po patchu "cy" zostaje w extended_locales. Nowy w 156
# kod (components/omnibox/resources/BUILD.gn, components/strings/BUILD.gn)
# liczy `all_chrome_locales - extended_locales - [...]` (to już usuwa "cy"),
# a potem `if (is_android) { X -= [ "cy" ] }` -- GN: "Item not found", bo
# odejmowanie nieobecnego elementu jest w GN błędem. Poprawka: przed każdym
# takim `X -= [ "cy" ]` dopisujemy `X += [ "cy" ]` -- `-=` usuwa WSZYSTKIE
# wystąpienia, więc wynik jest ten sam co zamierzał upstream (bez "cy"), a brak
# elementu przestaje być błędem. Sprawdzone binarką gn z drzewa 156 (lista
# z "cy" i bez "cy"). `filter_exclude` odpadło: GN zabrania nadpisania
# niepustej listy przez `=` ("Replacing nonempty list"). Przeszukujemy całe
# components/ i chrome/, żeby kolejne wersje z nowymi takimi miejscami też
# przeszły; krok jest idempotentny.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cd /srcbuild && \
    python3 - <<'PYEOF'
import re, subprocess
files = subprocess.run(
    ["grep", "-rlE", "--include=*.gn", "--include=*.gni",
     r'^\s+[A-Za-z_]+ -= \[ "cy" \]$', "components", "chrome"],
    capture_output=True, text=True).stdout.split()
pat = re.compile(r'^(\s+)([A-Za-z_]+) -= \[ "cy" \]$')
changed = 0
for f in files:
    lines = open(f, encoding="utf-8").read().split("\n")
    out = []
    before = changed
    for l in lines:
        m = pat.match(l)
        if m:
            add = f'{m.group(1)}{m.group(2)} += [ "cy" ]'
            if not (out and out[-1] == add):
                out.append(add)
                changed += 1
        out.append(l)
    if changed > before:
        open(f, "w", encoding="utf-8").write("\n".join(out))
    print(f"  {f} (+{changed - before})")
print(f"==> odejmowanie \"cy\" uodpornione: {len(files)} plików, {changed} nowych linii")
PYEOF

# ==============================================================================
# 5g. Wbudowany updater APK (self_update)
# ==============================================================================
#     Opis: README. Źródła z android_updater/ tego repo
#     trafiają do drzewa jako chrome/browser/self_update/android/ (pakiet
#     org.chromium.chrome.browser.self_update), a do istniejących plików
#     Chromium dochodzą cztery wstawki:
#       1. zależność w chrome/android/BUILD.gn,
#       2. dwa wywołania w ChromeActivitySessionTracker.java (wejście na
#          pierwszy plan i zejście z niego),
#       3. uprawnienie UPDATE_PACKAGES_WITHOUT_USER_ACTION w manifeście,
#       4. <receiver> wyniku instalacji w manifeście.
#     Każda wstawka jest zakotwiczona TREŚCIĄ sąsiedniej linii, a krok
#     przerywa build z "BŁĄD: self_update: ...", gdy kotwica nie występuje
#     dokładnie raz albo wstawka po przebiegu nie występuje dokładnie raz.
#     Krok jest idempotentny: /srcbuild jest trwały, więc zwykle wykonuje się
#     na drzewie, które wstawki już ma.
#
#     ARG-i są zadeklarowane dopiero TUTAJ: wcześniej każda zmiana tagu
#     unieważniałaby krok 4c (zasilenie /srcbuild od nowa = pełna kompilacja).
#     Tutaj zmiana kosztuje tylko gn gen i przeliczenie celów Javy.
#
#     UpdaterConfig.java jest generowany z ARG-ów. Pliki są nadpisywane tylko
#     przy zmianie treści -- ninja patrzy na czasy modyfikacji, a każde
#     dotknięcie źródeł Javy to ponowne R8 całej przeglądarki.
#
#     Wariant vanilla nie dostaje updatera: to test "czy sam pipeline i ta
#     wersja Chromium są zdrowe", bez żadnych naszych zmian w źródłach.
COPY android_updater/self_update/ /repo/self_update/java/
COPY android_updater/BUILD.gn /repo/self_update/BUILD.gn
ARG UPDATE_REPO=""
ARG RELEASE_TAG=""
ARG UPDATE_API_URL=""
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then echo "==> wariant ${VARIANT}: bez updatera"; exit 0; fi; \
    cd /srcbuild && \
    python3 - <<'PYEOF'
import os, re, sys

def die(msg):
    sys.exit("BŁĄD: self_update: " + msg)

repo = os.environ.get("UPDATE_REPO", "")
tag = os.environ.get("RELEASE_TAG", "")
api = os.environ.get("UPDATE_API_URL", "")
# Wartości lądują w literałach Javy -- nic poza bezpiecznym zestawem znaków.
if repo and not re.fullmatch(r"[A-Za-z0-9._-]+/[A-Za-z0-9._-]+", repo):
    die(f"UPDATE_REPO={repo!r} nie ma postaci właściciel/nazwa")
if tag and not re.fullmatch(r"[0-9]+(\.[0-9]+)*-[0-9]+", tag):
    die(f"RELEASE_TAG={tag!r} nie ma postaci <wersja>-<N>")
if api and not re.fullmatch(r"https?://[A-Za-z0-9._:/?=&%-]+", api):
    die(f"UPDATE_API_URL={api!r} zawiera niedozwolone znaki")
if repo and not tag:
    die("UPDATE_REPO bez RELEASE_TAG (budować przez build_android.sh)")

def write_if_changed(path, text):
    try:
        if open(path, encoding="utf-8").read() == text:
            return
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    open(path, "w", encoding="utf-8").write(text)
    print("  zapisano", path)

# --- źródła -----------------------------------------------------------------
base = "chrome/browser/self_update/android"
java_dir = base + "/java/src/org/chromium/chrome/browser/self_update"
wanted = {base + "/BUILD.gn": open("/repo/self_update/BUILD.gn", encoding="utf-8").read()}
for name in sorted(os.listdir("/repo/self_update/java")):
    if name.endswith(".java"):
        wanted[java_dir + "/" + name] = open(
            "/repo/self_update/java/" + name, encoding="utf-8").read()
# Znaczniki "selfupdate-...=<wartość>" muszą być POJEDYNCZYMI literałami: po
# nich release_android.sh odczytuje z gotowego APK tag, repozytorium i to,
# czy build jest testowy (`unzip -p apk 'classes*.dex' | strings | grep`).
wanted[java_dir + "/UpdaterConfig.java"] = f"""package org.chromium.chrome.browser.self_update;

/** Parametry builda -- plik generowany w kroku 5g Containerfile.android. */
public final class UpdaterConfig {{
    public static final String UPDATE_REPO = "{repo}";
    public static final String RELEASE_TAG = "{tag}";
    public static final String UPDATE_API_URL = "{api}";

    public static final String RELEASE_TAG_MARKER = "selfupdate-release-tag={tag}";
    public static final String REPO_MARKER = "selfupdate-repo={repo}";
    public static final String TEST_API_MARKER = "selfupdate-test-api={api}";

    private UpdaterConfig() {{}}
}}
"""
for path, text in wanted.items():
    write_if_changed(path, text)
for root, _, files in os.walk("chrome/browser/self_update"):
    for name in files:
        path = os.path.join(root, name)
        if path not in wanted:
            os.remove(path)
            print("  usunięto", path)

# --- wstawki ------------------------------------------------------------------
def insert(path, anchor, new_lines, marker, before=False):
    """Wstawia new_lines przy JEDYNEJ linii zawierającej anchor, z jej wcięciem."""
    text = open(path, encoding="utf-8").read()
    lines = text.split("\n")
    hits = [i for i, line in enumerate(lines) if anchor in line]
    if len(hits) != 1:
        die(f"kotwica {anchor!r} występuje {len(hits)} razy w {path} (oczekiwano 1)")
    if marker not in text:
        line = lines[hits[0]]
        indent = line[:len(line) - len(line.lstrip())]
        at = hits[0] if before else hits[0] + 1
        lines[at:at] = [indent + new for new in new_lines]
        text = "\n".join(lines)
        open(path, "w", encoding="utf-8").write(text)
        print(f"  wstawka w {path}: {marker}")
    if text.count(marker) != 1:
        die(f"{marker!r} występuje {text.count(marker)} razy w {path} (oczekiwano 1)")

insert("chrome/android/BUILD.gn",
       '"//chrome/browser/omaha/android:java",',
       ['"//chrome/browser/self_update/android:java",'],
       '"//chrome/browser/self_update/android:java",')

# Pełne nazwy klas zamiast importów: jedna linia = jedna kotwica mniej.
tracker = "chrome/android/java/src/org/chromium/chrome/browser/ChromeActivitySessionTracker.java"
call = ("org.chromium.chrome.browser.self_update.SelfUpdater.{}("
        "org.chromium.base.ContextUtils.getApplicationContext());")
insert(tracker, "mOmahaServiceStartDelayer.onForegroundSessionStart();",
       [call.format("onForegroundStart")], "SelfUpdater.onForegroundStart(")
insert(tracker, "mOmahaServiceStartDelayer.onForegroundSessionEnd();",
       [call.format("onForegroundEnd")], "SelfUpdater.onForegroundEnd(")

manifest = "chrome/android/java/AndroidManifest.xml"
insert(manifest, 'android:name="android.permission.REQUEST_INSTALL_PACKAGES"',
       ['<uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"/>'],
       "android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION")
insert(manifest,
       'android:name="org.chromium.chrome.browser.upgrade.PackageReplacedBroadcastReceiver"',
       ['<receiver android:name="org.chromium.chrome.browser.self_update.SelfUpdateResultReceiver"',
        '    android:exported="false" />'],
       "org.chromium.chrome.browser.self_update.SelfUpdateResultReceiver", before=True)

print(f"==> self_update: repo={repo!r} tag={tag!r} api={api!r}, 4 wstawki OK")
PYEOF

# ==============================================================================
# 6. Konfiguracja GN
# ==============================================================================
#    Cromite i jego `cromite.gn_args` (pełna składnia GN, nie płaska lista
#    klucz=wartość) zostały usunięte razem z całą resztą Cromite -- ten krok
#    ma teraz dwie gałęzie sterowane `VARIANT`, obie budujące zwykłą, płaską
#    listę par klucz=wartość przekazywaną do `gn gen --args=`.
#
#    Wariant VARIANT=vanilla: minimalny, zachowawczy zestaw (patrz gałąź niżej)
#    -- czyste Chromium, zero flag prywatnościowych, tylko to, co niezbędne do
#    poprawnego oficjalnego buildu Androida. Zweryfikowany end-to-end (`gn gen`
#    = 81079 targetów, ninja bez błędów, `.apk` na urządzeniu) w commicie
#    df64dfd, zanim ten tryb zniknął z pliku na rzecz utwardzonego -- teraz
#    przywrócony jako pełnoprawna trzecia gałąź `VARIANT`.
#
#    Wariant VARIANT=ungoogled (domyślny) nie używa cromite.gn_args, tylko
#    własnego zestawu flag prywatności. To "Plan B": maksimum prywatności
#    osiągalne SAMYMI FLAGAMI GN, bez ani jednego patcha -- a więc bez
#    kosztu utrzymania, który zabija podejście patchowe przy każdej nowej
#    wersji Chromium. Każda flaga poniżej została zweryfikowana `gn gen`
#    na realnym drzewie 151.0.7922.71: cały zestaw daje 73927 targetów i
#    ZERO ostrzeżeń "never appeared in a declare_args" (czyli żadna nie
#    jest literówką ani reliktem po starszej wersji Chromium).
#
#    Czego ten wariant NIE daje (świadome ograniczenia Planu B): wbudowanego
#    adblockera i mitygacji fingerprintingu (canvas/audio/WebGL) -- to
#    siedzi w patchach Cromite, nie we flagach. Nie udawaj, że utwardzenie
#    flagami jest równoważne Cromite.
#
#    Flagi ODRZUCONE po weryfikacji (nie dopisuj ich bez ponownego testu):
#      - enable_offline_pages=false, enable_supervised_users=false -- łamią
#        build Androida (`Assertion failed` w gn gen; na Androidzie te
#        moduły są wymagane),
#      - enable_platform_aac_audio / enable_platform_h264_video -- nie są
#        samodzielnymi declare_args (w cromite.gn_args siedzą w bloku
#        warunkowym), ustawianie ich wprost daje tylko ostrzeżenie,
#      - enable_safe_browsing, use_official_enterprise_policy_key,
#        enable_feed_v2, enable_click_to_call -- nie istnieją w 151
#        (poprawny odpowiednik Safe Browsing to `safe_browsing_mode`),
#      - build_tflite_with_xnnpack=false -- przechodzi `gn gen` I CAŁĄ
#        kompilację, a wywala się dopiero przy LINKOWANIU libchrome.so, na
#        60638 z 60641 targetów (trzy od końca!): "undefined symbol:
#        TfLiteXNNPackDelegate{OptionsDefault,Create,Delete}". Flaga wyłącza
#        budowanie XNNPACK w services/webnn/BUILD.gn i third_party/mediapipe/
#        BUILD.gn, ale wywołania zostają m.in. w
#        mediapipe/calculators/tensor/inference_calculator_xnnpack.cc.
#        Domyślnie na arm64 jest WŁĄCZONA (`current_cpu != "arm"`,
#        third_party/tflite/features.gni:18), więc upstream nie testuje jej
#        wyłączenia na Androidzie. Zysk prywatnościowy i tak był wątpliwy --
#        XNNPACK to backend obliczeń na CPU, nie telemetria.
#      - use_v8_context_snapshot=false (SAMO, bez include_both_v8_snapshots)
#        -- to NIE jest błąd gn gen ani ninja. Build przechodzi w 100%,
#        `.apk` się instaluje -- a renderer CRASHUJE natychmiast przy KAŻDEJ
#        stronie (nawet example.com), bo to niespójność między procesem
#        przeglądarki a procesem renderującym, nie błąd kompilacji.
#        Mechanizm (zweryfikowany symbolizacją tombstone'a przez
#        llvm-symbolizer na lib.unstripped/libchrome.so): domyślnie na
#        arm64+official `include_both_v8_snapshots=true`
#        (tools/v8_context_snapshot/v8_context_snapshot.gni) -- to włącza
#        BUILDFLAG(INCLUDE_BOTH_V8_SNAPSHOTS), przez co proces przeglądarki
#        (content_main_runner_impl.cc: GetSnapshotType) dla renderera prosi
#        o snapshot "z dodatkowym kontekstem" (kWithAdditionalContext).
#        Ale skoro use_v8_context_snapshot=false, taki plik nigdy nie
#        powstał -- renderer trafia na `NOTREACHED()` w
#        gin/v8_initializer.cc:GetSnapshotFileName i umiera SIGTRAP-em przy
#        starcie, zanim jakikolwiek kod strony się wykona. Naprawa: ustawić
#        `include_both_v8_snapshots=false` zamiast `use_v8_context_snapshot`
#        wprost -- to samo robi cromite.gn_args dla release Android
#        (`else { include_both_v8_snapshots = false ... }`), bo
#        `use_v8_context_snapshot` i tak DERYWUJE się z
#        `include_both_v8_snapshots` (`||` w declare_args, drugi operand
#        zawsze false na Androidzie) -- oba buildflagi wychodzą spójnie
#        false. Zweryfikowane `gn args --list` przed rebuildem.
#        LEKCJA: to CZWARTY przypadek flagi łamiącej Androida, i pierwszy,
#        który przeszedł CAŁY build (gn gen + ninja + link + .apk) i ujawnił
#        się dopiero w runtime na urządzeniu -- "zbudowało się bez błędów"
#        nie znaczy "działa". Stąd zasada, żeby po
#        KAŻDEJ zmianie zestawu flag faktycznie odpalić .apk na urządzeniu,
#        nie tylko sprawdzić czy build przeszedł.
#      - enable_vr/enable_arcore/enable_cardboard=false -- `gn gen` przechodzi
#        (74272 targety), ale ninja WYWALA SIĘ po ~55500 targetów na
#        chrome/browser/ui/omnibox/omnibox_edit_model.cc:1881: "no member named
#        GetVectorIcon in AutocompleteMatch". Powód: w
#        components/omnibox/browser/autocomplete_match.h:378 metoda jest
#        zadeklarowana pod `#if (!IS_ANDROID || ENABLE_VR) && !IS_IOS`, czyli na
#        Androidzie ISTNIEJE TYLKO GDY VR jest włączone -- a wywołanie w
#        omnibox_edit_model.cc nie jest niczym strzeżone (Cromite też tego pliku
#        nie łata; na 148.x kod wyglądał inaczej). UWAGA NA PUŁAPKĘ:
#        `enable_vr` jest WYLICZANE (`enable_openxr || enable_cardboard ||
#        enable_arcore`, device/vr/buildflags/buildflags.gni:36), więc samo
#        usunięcie `enable_vr=false` nie wystarczy -- trzeba też przestać
#        wyłączać arcore i cardboard, bo inaczej VR i tak wyjdzie false.
#        Zostaje `enable_openxr=false` (na Androidzie i tak już false przez
#        `checkout_openxr`). Cena: powierzchnia WebXR zostaje, ale typowy tablet nie ma
#        sprzętu XR, a ARCore wymaga osobnej apki Google.
#      - safe_browsing_mode=0 -- `gn gen` przechodzi, ale ninja WYWALA SIĘ
#        po ~26000 targetów. To niespójność samego Chromium, nie nasz błąd:
#        components/enterprise/connectors/core/BUILD.gn buduje
#        `cloud_content_scanning` pod warunkiem
#        `enterprise_cloud_content_analysis || is_android`, czyli na
#        Androidzie ZAWSZE -- mimo że samo `enterprise_cloud_content_analysis`
#        jest tam domyślnie false. Ten kod woła
#        WebUIContentInfoSingleton::AddToDeepScan{Requests,Responses} i
#        AddHeadersToDeepScanRequests, zadeklarowane tylko pod
#        BUILDFLAG(SAFE_BROWSING_DOWNLOAD_PROTECTION), które
#        safe_browsing_mode=0 wyłącza (components/safe_browsing/BUILD.gn:27).
#        Domyślny tryb dla Androida to 2 (buildflags.gni:19). Naprawa
#        wymagałaby łatania źródeł -- a to przekreśla sens tego wariantu
#        ("tylko flagi, zero kosztu utrzymania"), więc świadomie zostawiamy
#        Safe Browsing włączone. Na Androidzie i tak chodzi ono przez GMS
#        Core, którego zdeGooglowany LineageOS zwykle nie ma, a bez kluczy
#        API i tak nie ma z czym rozmawiać.
#      - enable_pdf/enable_print_preview/enable_session_service=false --
#        działają, ale to strata funkcjonalności bez zysku prywatności.
#
#    Uwagi do wybranych flag:
#      - safe_browsing_mode=0: Safe Browsing i tak jest bezczynne bez kluczy
#        API, więc to głównie redukcja powierzchni ataku. ŚWIADOMY KOMPROMIS:
#        tracimy lokalną ochronę przed phishingiem/malware.
#      - enable_captive_portal_detection=false: wycina automatyczne odpytywanie
#        endpointów Google przy wykrywaniu sieci z logowaniem.
#      - puste google_api_key/client_id/client_secret obok
#        use_official_google_api_keys=false -- pas i szelki.
#      - treat_warnings_as_errors=false: wchodzimy na milestone nietestowany
#        przez nikogo z tymi flagami, przypadkowy warning nie powinien zabić
#        wielogodzinnego builda.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    cd /srcbuild && \
    export PATH="/repo/depot_tools:${PATH}" && \
    if [ "${VARIANT}" = "vanilla" ]; then \
        GN_ARGS="target_os = \"android\" target_cpu = \"arm64\" \
is_debug = false is_official_build = true is_component_build = false \
symbol_level = 1 blink_symbol_level = 1 chrome_pgo_phase = 0 \
cc_wrapper = \"ccache\" use_clang_modules = false use_official_google_api_keys = false \
dcheck_always_on = false treat_warnings_as_errors = false \
proprietary_codecs = true ffmpeg_branding = \"Chrome\" android_channel = \"stable\""; \
    elif [ "${VARIANT}" = "ungoogled" ]; then \
        GN_ARGS="target_os = \"android\" target_cpu = \"arm64\" \
is_debug = false is_official_build = true is_component_build = false \
symbol_level = 1 blink_symbol_level = 1 chrome_pgo_phase = 0 \
cc_wrapper = \"ccache\" use_clang_modules = false dcheck_always_on = false treat_warnings_as_errors = false \
android_channel = \"stable\" \
proprietary_codecs = true ffmpeg_branding = \"Chrome\" enable_av1_decoder = true enable_dav1d_decoder = true \
use_official_google_api_keys = false google_api_key = \"\" google_default_client_id = \"\" google_default_client_secret = \"\" \
enable_reporting = false enable_mdns = false enable_remoting = false enable_hangout_services_extension = false \
disable_fieldtrial_testing_config = true build_contextual_search = false \
enable_openxr = false \
enable_bound_session_credentials = false safe_browsing_use_unrar = false enable_request_header_integrity = false \
include_both_v8_snapshots = false \
enable_speech_service = false enable_screen_ai_service = false \
enable_service_discovery = false enable_captive_portal_detection = false"; \
    else \
        echo "BŁĄD: nieznany VARIANT='${VARIANT}' (oczekiwano: ungoogled|vanilla)" >&2 && exit 1; \
    fi && \
    echo "==> GN_ARGS: ${GN_ARGS}" && \
    gn gen --args="$GN_ARGS" out/arm64 && \
    gn args out/arm64 --list > /repo/gn_args_list.txt

# 7. Kompilacja (ninja) — `chrome_public_apk`. ccache w persystentnym
#    cache mouncie (osobny id od buildów desktopowych). NINJA_JOBS domyślnie
#    NIŻSZE niż desktop (8, nie $(nproc)=16) — build Android (R8/dex/linking
#    wielu ABI) jest bardziej pamięciożerny niż czysty C++, a poniżej
#    zalecanych przez Chromium 32 GB RAM build ratuje się swapem.
#    Zweryfikowane ręcznie w kontenerze debug: pełny dry-run
#    (`ninja -C out/arm64 chrome_public_apk -n`) rozwiązuje cały graf
#    (60310 kroków) bez błędów, kończąc się poprawnie na
#    //chrome/android:chrome_public_apk__create.
#
# BŁĄD ZŁAPANY W NINJA (15. przypadek, ~16554/60700 -- ZUPEŁNIE INNA
# rodzina niż poprzednie 14, nie ma nic wspólnego z patchami ani
# is_android): `build/android/gyp/jinja_template.py` (zwykły, niepatchowany
# skrypt Chromium) pada `TypeError: %i format: a real number is required,
# not dict` / `ValueError: badly formed help string` wewnątrz
# `argparse.add_argument()` -- to NIE literówka w kodzie Chromium, tylko
# realna niekompatybilność: krok 1 tego Containerfile instaluje `python3`
# przez `apt-get install` BEZ przypięcia wersji, a `ubuntu:26.04`
# ("resolute", bardzo świeże wydanie) w swoich repo ma DZIŚ Python
# **3.14**, którego `argparse` dostał nowszą, bardziej agresywną
# walidację `help=` (eager-checking string formatowania przy
# `add_argument()`, nie tylko przy `--help`) -- łamie to legalny,
# wieloletni kod Chromium, który ma dosłowny znak `%`/`{% %}` (Jinja2) w
# tekście pomocy. Wcześniejsze 14 prób tego NIE złapało, bo korzystały z
# WARSTWY apt-get zacache'owanej z wcześniejszego (starszego) stanu repo
# Ubuntu -- dopiero PRAWDZIWIE zimny build (po utracie cache warstw) ściągnął dzisiejszy, nowszy pakiet `python3`.
# Fix: NIE dotykamy wczesnych, już-działających kroków (ryzyko zepsucia
# czegoś, co dotąd działało) -- tylko w TYM kroku (ninja, jedyne miejsce,
# gdzie to wybuchło) podmieniamy PRIORYTET w PATH przez `/usr/local/bin/
# python3`, żeby WSZYSTKIE wywołania gołego `python3` przez reguły ninja
# (setki skryptów `build/android/gyp/*.py`, wywoływanych bezpośrednio,
# nie przez `vpython3`) trafiały na kompatybilną wersję. Nie naprawiamy
# pojedynczego skryptu (za dużo analogicznych miejsc w całym drzewie do
# audytu, klasyczne ryzyko "whack-a-mole").
#
# ŹRÓDŁO kompatybilnego pythona: PIERWSZA próba (`apt-get install
# python3.12`) zawiodła -- "resolute" (Ubuntu 26.04) nie ma go w ŻADNYM
# archiwum (sprawdzone: ani `ftp.icm.edu.pl`, ani oficjalne
# `archive.ubuntu.com` -- to nie luka jednego mirrora, pakiet po prostu
# nie istnieje dla tego wydania). Zamiast pobierać cokolwiek dodatkowego:
# `depot_tools` JUŻ ma własny, zarządzany przez CIPD Python, całkowicie
# niezależny od systemowego apt -- `/repo/depot_tools/python-bin/python3`
# (3.11.8), dokładnie ten sam mechanizm co `vpython3`. Zweryfikowane w
# kontenerze debug (nie na oko): ten interpreter POPRAWNIE parsuje
# dokładnie ten sam `help=` string z `%`, który wywalał się na
# systemowym 3.14 -- 3.11 nie ma jeszcze nowej, agresywnej walidacji
# argparse wprowadzonej w 3.13/3.14.
#
# PUŁAPKA złapana przy pierwszym wdrożeniu: `python-bin/python3` to NIE
# surowy plik binarny, tylko skrypt bash (`DEPOT_TOOLS=$(dirname "$0")/..`),
# który liczy swój katalog z `$0` BEZ rozwijania symlinków -- zwykły
# `ln -sf` pod `/usr/local/bin/python3` sprawiał, że `$0` wskazywał na
# `/usr/local/bin`, `dirname`/`..` dawało `/`, i skrypt szukał
# `/python3_bin_reldir.txt` (nie istnieje) -> ten sam błąd co przy
# apt-get. Fix: wrapper z `exec` na BEZWZGLĘDNĄ ścieżkę zamiast symlinka
# -- `$0` wewnątrz `python-bin/python3` wtedy poprawnie wskazuje na jego
# prawdziwą lokalizację. Zweryfikowane w kontenerze debug.
ARG NINJA_JOBS=8
# `/ccache` na TRWAŁYM cache mouncie (id=ccache-android). Od 2026-08-08 do
# 2026-10-30 celowo ulotny: /srcbuild daje inkrementalność ninja w obrębie
# jednej wersji. Ale od 2026-10-26 krok 4c zasila /srcbuild od nowa przy
# każdej zmianie wersji, więc bez ccache każde podbicie -- nawet
# poprawkowe (156.0.8078.73 -> .79) -- kompiluje wszystkie ~61 tys. celów
# od zera. Przywrócony 2026-10-30: co przyspiesza
# budowanie, zostaje na dysku. Limit 40G.
# Moduły Clanga wyłączone w GN (use_clang_modules = false, krok gn gen):
# z nimi ccache odrzucał ~82% kompilacji ("could_not_use_modules",
# zmierzone na 156.0.8078.79), a tryb sloppiness=modules nie hashuje .pcm
# ani nagłówków libc++ (sprawdzone na pliku .d) -- po zmianie libc++
# oddałby po cichu stare obiekty. Bez modułów ccache działa w zwykłym,
# bezpiecznym trybie dla wszystkich kompilacji.
ENV CCACHE_DIR=/ccache
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    --mount=type=cache,target=/ccache,id=ccache-android \
    cd /srcbuild && \
    printf '#!/bin/bash\nexec /repo/depot_tools/python-bin/python3 "$@"\n' > /usr/local/bin/python3 && \
    chmod +x /usr/local/bin/python3 && \
    echo "==> python3 dla ninja: $(python3 --version) ($(command -v python3))" && \
    export PATH="/usr/local/bin:/repo/depot_tools:${PATH}" && \
    export NODE_OPTIONS="--max-old-space-size=8192" && \
    ccache -M 40G >/dev/null && \
    JOBS="${NINJA_JOBS:-$(nproc)}" && \
    echo "==> ninja -j${JOBS}" && \
    ninja -C out/arm64 chrome_public_apk -j"${JOBS}" && \
    ccache -s

# 8. Pakowanie i podpis — czytelna nazwa z wersją Chromium (analogicznie
#    do desktopowego kroku 10 pakowania .deb). Ścieżka `out/arm64/apks/
#    ChromePublic.apk` potwierdzona w chrome/android/BUILD.gn
#    (proguard_mapping_path = "$root_build_dir/apks/ChromePublic.apk.mapping").
#    Nazwa: <VARIANT>-chromium-<wersja>-arm64-v8a.apk -- arm64-v8a to
#    standardowa nazwa ABI Androida (jak lib/arm64-v8a/ w APK); APK nie ma
#    nic pod konkretne urządzenie (tylko target_cpu=arm64, minSdk 29), więc
#    bez nazwy urządzenia w nazwie pliku. Prefiks = ARG VARIANT
#    ("ungoogled"/"vanilla").
#
#    PODPIS. Ninja podpisuje APK publicznym kluczem debug Chromium
#    (build/android/chromium-debug.keystore -- leży w otwartych źródłach,
#    więc każdy może nim podpisać plik, który Android przyjmie jako
#    aktualizację). Gdy build_android.sh poda własny klucz, APK jest tu
#    podpisywany ponownie:
#    - klucz i hasło przychodzą jako sekrety (/run/secrets/...), więc nie
#      trafiają do warstwy obrazu ani do logu;
#    - podpisany plik powstaje od razu w /output_apk; APK w /srcbuild
#      zostaje nietknięty (to wyjście ninja -- zmieniony udawałby wynik
#      builda przy następnym przebiegu, także tym bez klucza);
#    - SIGNING_CERT_SHA256 (odcisk certyfikatu, liczony na hoście) robi dwie
#      rzeczy. Po pierwsze unieważnia cache tego kroku: sama zawartość
#      sekretu nie wchodzi do klucza cache, więc bez ARG-u krok oddałby
#      z cache APK z poprzednim podpisem. Po drugie krok porównuje z nim
#      odcisk gotowego pliku i przerywa build przy niezgodności;
#    - bez schematu v1 (minSdk 29 go nie potrzebuje): apksigner nie dopisuje
#      wtedy plików do archiwum, więc wpisy i ich wyrównanie zostają takie,
#      jak je ułożył build -- `zipalign -c` to potwierdza. Z v2+v3 zostaje
#      w praktyce samo v3: przy minSdk >= 28 apksigner pomija v2 jako zbędne
#      (sprawdzone na 157: "Verified using v3 scheme: true", v2: false);
#    - odcisk czytamy z KAŻDEJ linii "certificate SHA-256 digest:" i wymagamy
#      jednej wartości: prefiks linii zależy od wersji apksignera i schematu
#      ("V3.0 Signer:", "V2 Signer:", dawniej "Signer #1").
#    Nie używamy argumentów GN android_keystore_*: wymagałyby klucza
#    w drzewie podczas ninja i ponownego gn gen.
ARG SIGNING_CERT_SHA256=""
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    --mount=type=secret,id=android_keystore \
    --mount=type=secret,id=android_keystore_pass \
    CHROMIUM_TAG=$(cat /repo/chromium_tag.txt) && \
    SRC=/srcbuild/out/arm64/apks/ChromePublic.apk && \
    OUT="/output_apk/${VARIANT}-chromium-${CHROMIUM_TAG}-arm64-v8a.apk" && \
    mkdir -p /output_apk && \
    if [ -z "${SIGNING_CERT_SHA256}" ]; then \
        echo "==> bez własnego klucza: APK zostaje z publicznym kluczem debug Chromium" && \
        cp "$SRC" "$OUT"; \
    else \
        KS=/run/secrets/android_keystore && KP=/run/secrets/android_keystore_pass && \
        { [ -s "$KS" ] && [ -s "$KP" ]; } || { echo "BŁĄD: podano SIGNING_CERT_SHA256, ale brak sekretów android_keystore / android_keystore_pass"; exit 1; }; \
        JAVA=/srcbuild/third_party/jdk/current/bin/java && \
        set -- /srcbuild/third_party/android_sdk/public/build-tools/*/lib/apksigner.jar && \
        { [ "$#" -eq 1 ] && [ -f "$1" ]; } || { echo "BŁĄD: oczekiwano dokładnie jednego apksigner.jar w build-tools, jest: $*"; exit 1; }; \
        SIGNER="$1" && ZIPALIGN="$(dirname "$(dirname "$1")")/zipalign" && \
        APKSIGNER="$JAVA --enable-native-access=ALL-UNNAMED -jar $SIGNER" && \
        $APKSIGNER sign --ks "$KS" --ks-pass "file:$KP" \
            --v1-signing-enabled false --v2-signing-enabled true --v3-signing-enabled true \
            --v4-signing-enabled false --out "$OUT" "$SRC" && \
        GOT=$($APKSIGNER verify --print-certs "$OUT" \
              | sed -n 's/^.*certificate SHA-256 digest: //p' | sort -u) && \
        { [ -n "$GOT" ] && [ "$GOT" = "${SIGNING_CERT_SHA256}" ]; } || { echo "BŁĄD: odcisk certyfikatu APK ('$GOT') nie zgadza się z SIGNING_CERT_SHA256 ('${SIGNING_CERT_SHA256}')"; exit 1; }; \
        "$ZIPALIGN" -c 4 "$OUT" && \
        rm -f "$OUT.idsig" && \
        echo "==> APK podpisany własnym kluczem, odcisk certyfikatu: $GOT"; \
    fi && \
    ls -la /output_apk/

# ==============================================================================
# 9. ETAP EKSPORTU — jak w desktopowym Containerfile: `builder` ma w sobie
# całe drzewo źródeł Chromium (setki GB), więc tagowany finalny obraz
# zawiera tylko gotowy .apk.
# ==============================================================================
FROM alpine:3.20 AS export
COPY --from=builder /output_apk/*.apk /output_apk/
CMD sh -c '\
    [ "$(stat -c %d /host_output 2>/dev/null)" != "$(stat -c %d /host_output/.. 2>/dev/null)" ] || \
        { echo "BŁĄD: /host_output nie jest zamontowany. Uruchom z: podman run --rm -v \$(pwd):/host_output <obraz>"; exit 1; }; \
    cp /output_apk/*.apk /host_output/ && echo "🎉 Kopiowanie zakończone! APK gotowy."'
