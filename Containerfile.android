# BŁĄD ZŁAPANY NA URZĄDZENIU (19. przypadek, DRUGI crash po naprawie
# osiemnastego) -- ta sama kategoria "build/link OK, crash dopiero przy
# starcie", ta sama metoda diagnozy (symbolizacja tombstone'a przez
# llvm-symbolizer, `/srcbuild` pozwala wyciągnąć `lib.unstripped/
# libchrome.so` bez czekania na kolejny build). Łańcuch: `SigninManagerImpl`
# (Java, przy starcie) -> JNI -> `signin::JniIdentityMutator::
# SeedAccountsThenReloadAllAccountsWithPrimaryAccount` ->
# `ProfileOAuth2TokenServiceDelegateAndroid::
# SeedAccountsThenReloadAllAccountsWithPrimaryAccount` ->
# `CHECK_NE(fire_refresh_token_loaded_, RT_LOAD_NOT_START)` fail --
# invariant "LoadCredentials musi się wykonać przed tym wywołaniem"
# złamany, bo NIGDY się nie wykonuje.
#
# Przyczyna: `remove-unused-preferences-fields.patch` usuwa niemal CAŁE
# ciało konstruktora `PrimaryAccountManager::PrimaryAccountManager`
# (components/signin/internal/identity_manager/primary_account_manager.cc)
# -- CELOWO, to sedno patcha: zamiast odczytywać `kGoogleServicesAccountId`/
# `kGoogleServicesConsentedToSync` z prefs i PRZYWRACAĆ poprzednie
# zalogowanie, konstruktor teraz zawsze wymusza puste konto
# (`SetPrimaryAccountInternal(CoreAccountInfo(), consented_to_sync=false,
# ...)`) -- to jest INTENCJONALNA, zgodna z duchem projektu blokada
# przywracania sesji logowania, NIE zostawiamy tego jak było. ALE razem z
# tym usunięty został też, niepowiązany z blokadą logowania,
# `token_service_observation_.Observe(token_service_)` +
# `token_service_->LoadCredentials(...)` -- inicjalizacja maszyny stanów
# tokenów OAuth2, potrzebna ZAWSZE (niezależnie od tego, czy jest
# zalogowane konto), bo to ANDROIDOWY `SigninManagerImpl` bezwarunkowo
# zakłada, że się wykonała, zanim cokolwiek zrobi z kontami.
#
# Fix: przywrócić WYŁĄCZNIE te dwie linie (obserwację + LoadCredentials),
# NIE przywracać usuniętej logiki odczytu/przywracania prefs -- to
# zachowuje intencję prywatnościową patcha (nigdy nie przywracaj
# poprzedniego logowania) i naprawia tylko złamany invariant Androida.
# Zweryfikowane host-side na w pełni załatanym drzewie (pełny reset +
# reaplikacja 106 patchy, nie tylko tego jednego pliku -- nauczka z
# osiemnastego przypadku, gdzie test na częściowo-resetowanym drzewie dał
# fałszywy wynik).
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cat > /repo/fix_primary_account_manager_load_credentials.py <<'PYEOF'
#!/usr/bin/env python3
"""remove-unused-preferences-fields.patch celowo usuwa przywracanie
poprzedniego logowania z konstruktora PrimaryAccountManager (zostaje) --
ale przy okazji usuwa tez token_service_->LoadCredentials(), potrzebne
ZAWSZE (Android SigninManagerImpl tego wymaga bezwarunkowo). Przywracamy
TYLKO te dwie linie, nie ruszamy reszty (celowo usunieta logika prefs)."""
import sys
from pathlib import Path

SRC = Path(sys.argv[1] if len(sys.argv) > 1 else "/srcbuild")
f = SRC / "components/signin/internal/identity_manager/primary_account_manager.cc"
text = f.read_text()

new_marker = "  token_service_observation_.Observe(token_service_);\n"
if new_marker in text:
    print("LoadCredentials juz przywrocone, pomijam")
else:
    old = """  // PrimaryAccountManager is initialized once the primary account and consent
  // level are loaded.
  CHECK(primary_account_.has_value());
}

PrimaryAccountManager::~PrimaryAccountManager() = default;"""
    new = """  // PrimaryAccountManager is initialized once the primary account and consent
  // level are loaded.
  CHECK(primary_account_.has_value());

  // It is important to only load credentials after starting to observe the
  // token service.
  token_service_observation_.Observe(token_service_);
  token_service_->LoadCredentials(
      GetPrimaryAccountId(signin::ConsentLevel::kSignin));
}

PrimaryAccountManager::~PrimaryAccountManager() = default;"""
    count = text.count(old)
    assert count == 1, f"oczekiwano 1, znaleziono {count}"
    f.write_text(text.replace(old, new))
    print("primary_account_manager.cc: LoadCredentials przywrocone")
PYEOF

RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
