# Przyczyna, GŁĘBSZA niż szesnasty/siedemnasty przypadek: to nie brak
# include'a ani zła kwalifikacja namespace -- `remove-unused-preferences-
# fields.patch` usuwa z `chrome/browser/prefs/browser_prefs.cc` SAME
# WYWOŁANIA `safe_browsing::RegisterLocalStatePrefs(registry);` (w
# `RegisterLocalState`) i `safe_browsing::RegisterProfilePrefs(registry);`
# (w `RegisterProfilePrefs`) -- razem z `#include ".../safe_browsing_
# prefs.h"`, którego te wywołania potrzebują. Efekt: NAWET PO przywróceniu
# targetu (16.) i naprawieniu kompilacji (17.), funkcja `safe_browsing::
# RegisterProfilePrefs()` (dziesiątki `Register*Pref` w środku, w tym
# NASZ WŁASNY literał `kSafeBrowsingEnabled` z sekcji 5e!) nigdy się nie
# wykonuje -- kompiluje się poprawnie, ale nikt jej nie woła. Ten sam,
# już dobrze poznany wzorzec (wykluczenie `fix-building-without-
# safebrowsing.patch` zostawia osierocone pół-zmiany), ale na jeszcze
# GŁĘBSZYM poziomie niż poprzednie dwa przypadki -- tu padła cała ścieżka
# WOŁANIA, nie tylko deklaracja pojedynczego symbolu.
#
# LEKCJA (rozszerza siedemnasty przypadek): "build się udał, `.apk` się
# zainstalował" dalej NIE dowodzi, że dana ścieżka kodu działa -- trzeba
# faktycznie URUCHOMIĆ aplikację i sprawdzić crash log/tombstone. Ten
# konkretny błąd był NIEWIDOCZNY na każdym wcześniejszym etapie (gn gen,
# ninja, link) i ujawnił się DOPIERO przy realnym starcie na urządzeniu.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cat > /repo/fix_browser_prefs_safe_browsing_calls.py <<'PYEOF'
#!/usr/bin/env python3
"""remove-unused-preferences-fields.patch usuwa z browser_prefs.cc wywolania
safe_browsing::RegisterLocalStatePrefs/RegisterProfilePrefs (+ include) --
bezpieczne tylko razem z wykluczonym fix-building-without-safebrowsing.patch,
ktory usuwalby cala definicje tych funkcji. My ja przywrocilismy (16./17.
przypadek), wiec trzeba przywrocic tez WYWOLANIA, inaczej funkcje nigdy sie
nie wykonuja mimo ze poprawnie istnieja i kompiluja."""
import sys
from pathlib import Path

SRC = Path(sys.argv[1] if len(sys.argv) > 1 else "/srcbuild")
f = SRC / "chrome/browser/prefs/browser_prefs.cc"
text = f.read_text()

include_line = '#include "components/safe_browsing/core/common/safe_browsing_prefs.h"\n'
if include_line in text:
    print("include safe_browsing_prefs.h juz obecny, pomijam")
else:
    anchor = '#include "components/safe_browsing/buildflags.h"\n'
    assert text.count(anchor) == 1, f"oczekiwano 1 zakotwiczenia include, znaleziono {text.count(anchor)}"
    text = text.replace(anchor, anchor + include_line)

local_state_call = "  safe_browsing::RegisterLocalStatePrefs(registry);\n"
if local_state_call in text:
    print("wywolanie RegisterLocalStatePrefs juz obecne, pomijam")
else:
    anchor = "  search_engines::SearchEngineChoiceService::RegisterLocalStatePrefs(registry);\n"
    assert text.count(anchor) == 1, f"oczekiwano 1 zakotwiczenia RegisterLocalState, znaleziono {text.count(anchor)}"
    text = text.replace(anchor, local_state_call + anchor)

profile_call = "  safe_browsing::RegisterProfilePrefs(registry);\n"
if profile_call in text:
    print("wywolanie RegisterProfilePrefs juz obecne, pomijam")
else:
    anchor = "  safety_check::prefs::RegisterProfilePrefs(registry);\n"
    assert text.count(anchor) == 1, f"oczekiwano 1 zakotwiczenia RegisterProfilePrefs, znaleziono {text.count(anchor)}"
    text = text.replace(anchor, profile_call + anchor)

f.write_text(text)
print("browser_prefs.cc: wywolania safe_browsing::Register*Prefs przywrocone")
PYEOF

RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
