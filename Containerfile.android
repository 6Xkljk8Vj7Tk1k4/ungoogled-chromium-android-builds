# ==============================================================================
# Android Builder — Chromium arm64
# Buduje chrome_public_apk z surowego chromium.googlesource.com/chromium/src
# (NIE ungoogled-chromium-android, martwy od Chromium 99). Osobny plik od
# desktopowego buildu ungoogled-chromium — inny pipeline: pełny
# gclient zamiast tarballa, wyjście .apk zamiast .deb.
#
# ARG VARIANT (domyślnie "ungoogled"):
#   - ungoogled: 39 flag GN + pełna seria patchy ungoogled-chromium
#     (wszystkie poza 2 wykluczonymi: 106/108 na 151, 108/110 na 156;
#     katalog `patches/` z klonu ungoogled-chromium) + literały
#     uzupełniające + domain_substitution -- codzienny wariant, zweryfikowany
#     end-to-end na fizycznym urządzeniu.
#   - vanilla: czyste Chromium bez żadnych patchy/literałów/domain_substitution
#     -- test izolujący "czy sam pipeline i ta wersja Chromium są zdrowe" bez
#     trudnej zmiennej patchy (przydatny przy każdym kolejnym skoku wersji).
#
# Cromite (uazo/cromite) CAŁKOWICIE usunięty z tego pliku (2026-08-07/08,
# było `ARG WITH_CROMITE`).
# ==============================================================================

FROM ubuntu:26.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# 1. Minimum do pobrania depot_tools/Chromium (domyślny mirror obrazu:
#    archive.ubuntu.com; ftp.icm.edu.pl usunięty 2026-10-26, przestał
#    odpowiadać -- to samo co w desktopowym Containerfile, commit 504cdbb).
#    Pełna lista zależności builda (w tym Android-specific) przychodzi
#    później z build/install-build-deps.sh --android, uruchamianego dopiero
#    po fetchu źródeł, zgodnie z
#    https://www.chromium.org/developers/how-tos/get-the-code/
#    Pętla retry (2026-10-26): pierwszy build po restarcie maszyny padł tu,
#    bo w trakcie pobierania paczek WSZYSTKIE adresy archive/security.ubuntu.com
#    (IPv4 i IPv6) naraz odpowiadały "connection refused" -- lokalna
#    przerwa łącza (przełączenie łącza), nie awaria Canonical; minutę
#    później wszystko działało. Wbudowane Acquire::Retries apt nie
#    przeczekuje takiej przerwy. Ten sam wzorzec co gclient sync niżej.
RUN sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/ubuntu.sources && \
    for i in 1 2 3 4; do \
        apt-get update && \
        apt-get install -y --no-install-recommends \
            git curl python3 python3-pip lsb-release sudo ca-certificates \
            xz-utils unzip zip file ccache && break; \
        [ "$i" = 4 ] && echo "BŁĄD: apt nie powiódł się po 4 próbach" && exit 1; \
        echo "==> apt nieudane (próba $i/4, chwilowa przerwa sieci?) -- retry za 60s..."; \
        sleep 60; \
    done && \
    rm -rf /var/lib/apt/lists/*

# 2. depot_tools
WORKDIR /repo
RUN git clone --depth 1 https://chromium.googlesource.com/chromium/tools/depot_tools.git depot_tools
ENV PATH="/repo/depot_tools:${PATH}"

# 3. Wersja -- JEDNO źródło prawdy: tag wydania ungoogled-chromium
#    (np. `156.0.8078.47-1`). Wersja Chromium = ten tag bez sufiksu `-N`.
#    Ten sam tag wyznacza patche i listy domain_substitution (klon
#    /repo/ungoogled-domsub niżej), więc źródła i patche ZAWSZE pasują do
#    siebie. Do 2026-10-26 Chromium był przypięty na sztywno do
#    151.0.7922.71, a patche szły z `releases/latest` -- działało tylko
#    dzięki cache warstw z sierpnia; po jego utracie patche 156 trafiłyby
#    na drzewo 151.
#
#    build_android.sh sam ustala najnowsze wydanie i podaje je jako
#    `--build-arg UC_VERSION=...`, więc cache warstw unieważnia się
#    DOKŁADNIE przy nowej wersji. Pusty UC_VERSION (bezpośredni `podman
#    build`) = pobranie `releases/latest` tutaj; wtedy obowiązuje pułapka
#    z desktopowego kroku 3 (krok trafiony w cache zostaje przy starej
#    wersji, bo tekst polecenia się nie zmienia).
ARG UC_VERSION=""
RUN UC="${UC_VERSION}" && \
    if [ -z "${UC}" ]; then \
        UC=$(curl -sf https://api.github.com/repos/ungoogled-software/ungoogled-chromium/releases/latest \
            | grep -oP '"tag_name": "\K[^"]+'); \
    fi && \
    [ -n "${UC}" ] || \
        (echo "BŁĄD: nie udało się pobrać wersji ungoogled-chromium z GitHub API (rate limit lub brak sieci)" && exit 1) && \
    CHROMIUM_TAG="${UC%-*}" && \
    echo "${CHROMIUM_TAG}" | grep -qxE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' || \
        (echo "BŁĄD: tag ungoogled '${UC}' nie ma postaci <wersja Chromium>-<N>" && exit 1) && \
    echo "==> ungoogled-chromium ${UC} -> Chromium ${CHROMIUM_TAG}" && \
    echo "${UC}" > /repo/uc_tag.txt && \
    echo "${CHROMIUM_TAG}" > /repo/chromium_tag.txt

# 4. Źródła Chromium — pełny gclient (NIE tarball jak w Containerfile
#    desktopowym): Android SDK/NDK i third_party są warunkowane w DEPS pod
#    target_os, więc tarball ungoogled-chromium-style ich nie przyniesie.
#
#    Nie używamy `fetch android` do samego sync: fetch.py nie ma opcji na
#    ograniczenie równoległości (sprawdzone: `fetch --help` nie ma flagi
#    jobs), a `gclient sync` domyślnie liczy max(8, NumLocalCpus())=16
#    wątków na tej maszynie — realnie wywołuje to HTTP 429 "Short term
#    server-time rate limit exceeded" z googlesource.com przy pierwszym
#    pełnym sync (zaobserwowane w praktyce: ffmpeg, gemmlowp, freetype,
#    harfbuzz, flatbuffers i kilkanaście innych third_party naraz).
#    Zamiast tego: ręczny płytki fetch samego tagu (bez ciągnięcia całej
#    historii/domyślnej gałęzi) + `gclient config --unmanaged` (żeby gclient
#    nie próbował zmienić już wybranego przez nas tagu) + kontrolowane -j4
#    z retry (gclient sync jest idempotentny — ponowne uruchomienie pomija
#    już pobrane zależności).
# UWAGA: od tego kroku aż do zasilenia /srcbuild (sekcja 4c) `/repo/
# chromium` żyje na TRWAŁYM cache mouncie (`id=chromium-checkout-android`),
# nie w zwykłych warstwach obrazu -- ten sam mechanizm i ten sam powód co
# `/srcbuild` niżej. Powód dopisany 2026-08-08: `gclient sync` samo w
# sobie tworzy warstwę rzędu dziesiątek GB (pełne DEPS z target_os=android),
# a commit TAKIEJ warstwy do zwykłego obrazu wymaga ~2x jej rozmiaru
# wolnego miejsca w /var/tmp (Podman kopiuje przez tar-pipe do nowego
# blobu) -- realnie złapane na żywo jako powtarzające się "no space left
# on device" nawet przy 130GB wolnego. Cache mount NIGDY nie jest
# committowany jako warstwa obrazu, więc ten problem znika całkowicie, A
# PRZY OKAZJI: gclient sync jest idempotentny (patrz komentarz wyżej), więc
# każdy PRZYSZŁY cache-miss warstw PRZED tym punktem (np. po kolejnym
# `podman image prune`) będzie tylko WERYFIKOWAŁ już pobrane zależności
# zamiast ciągnąć cały Chromium+Android DEPS od zera z sieci ponownie.
# Martwe połączenia (2026-10-26): po przełączeniu łącza
# otwarte połączenie TCP potrafi zostać bez ruchu na zawsze, a git/curl
# domyślnie nie ma żadnego limitu czasu -- gclient tylko wypisuje "STALL
# DETECTED" i czeka. Limit 1 B/s przez 600 s = przerwij wyłącznie transfer,
# który przez 10 minut nie dostał ANI BAJTU; git/gclient/pętle retry same
# ponawiają. Celowo nie niżej: płytki fetch całego chromium/src potrafi
# minutę-dwie czekać na paczkę bez żadnych danych (bez TTY nie ma postępu),
# a lista refów ls-remote płynie ~1,4 kB/s i też ma przejść.
ENV GIT_HTTP_LOW_SPEED_LIMIT=1 \
    GIT_HTTP_LOW_SPEED_TIME=600
WORKDIR /repo/chromium/src
# Checkout tagu na TRWAŁYM cache mouncie -- trzy przypadki:
#   - pusty mount (pierwszy build): git init + płytki fetch tagu;
#   - mount już na tym tagu: nic do roboty;
#   - mount na INNEJ wersji (podbicie, 2026-10-26): płytki fetch nowego
#     tagu + `checkout -f --detach`. Do 2026-10-26 obecność `.git`
#     pomijała fetch w ogóle, więc zmiana wersji była po cichu ignorowana
#     i dalej budowało się stare drzewo. gclient sync -D i `git submodule
#     update` niżej dociągają zależności nowej wersji (oba są
#     idempotentne). Bez `-b cromite-bump` (stary branch z Cromite):
#     `-b` na już istniejącym branchu wywalał drugi build na tym samym
#     `id=` (złapane 2026-08-08). Retry fetchu (2026-10-26): płytkie
#     pobranie całego chromium/src to jeden długi transfer, a pierwszy
#     testowy build 156 stracił go na zerwanym połączeniu ("unexpected
#     disconnect while reading sideband packet").
#   - lokalny `refs/remotes/origin/HEAD` (2026-10-26): gclient dla
#     rozwiązania --unmanaged i tak woła `scm.GIT.GetRemoteHeadRef`
#     (depot_tools scm.py). Bez lokalnego origin/HEAD (płytki fetch samego
#     tagu go nie tworzy) robi `git remote set-head -a`, a potem
#     `git ls-remote --symref <url> HEAD` -- ls-remote z wzorcem NIE
#     wysyła ref-prefix, więc serwer listuje WSZYSTKIE refy chromium/src,
#     w tym miliony `refs/changes/*`. W teście 156 gclient wisiał na `src`
#     ponad 20 minut. Wynik i tak jest bez znaczenia (unmanaged = tylko
#     fetch config), a gclient bierze lokalny symref od ręki.
RUN --mount=type=cache,target=/repo/chromium,id=chromium-checkout-android \
    CHROMIUM_TAG=$(cat /repo/chromium_tag.txt) && \
    if [ ! -d .git ]; then \
        git init -q && \
        git remote add origin https://chromium.googlesource.com/chromium/src.git; \
    fi && \
    HEAD_C=$(git rev-parse -q --verify HEAD 2>/dev/null || true) && \
    TAG_C=$(git rev-parse -q --verify "refs/tags/${CHROMIUM_TAG}^{commit}" 2>/dev/null || true) && \
    if [ -n "${HEAD_C}" ] && [ "${HEAD_C}" = "${TAG_C}" ]; then \
        echo "==> /repo/chromium/src już na ${CHROMIUM_TAG}, pomijam fetch"; \
    else \
        echo "==> Checkout ${CHROMIUM_TAG} (było: $(git describe --tags HEAD 2>/dev/null || echo 'pusto'))" && \
        for i in 1 2 3 4 5; do \
            git fetch --depth 1 origin "refs/tags/${CHROMIUM_TAG}:refs/tags/${CHROMIUM_TAG}" && break; \
            [ "$i" = 5 ] && echo "BŁĄD: git fetch ${CHROMIUM_TAG} nie powiódł się po 5 próbach" && exit 1; \
            echo "==> git fetch nieudany (próba $i/5, przerwa łącza albo HTTP 429) -- retry za 45s..."; \
            sleep 45; \
        done && \
        git checkout -q -f --detach "${CHROMIUM_TAG}"; \
    fi && \
    git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main && \
    echo "==> HEAD: $(git describe --tags HEAD)"

WORKDIR /repo/chromium
RUN --mount=type=cache,target=/repo/chromium,id=chromium-checkout-android \
    gclient config --name=src --unmanaged https://chromium.googlesource.com/chromium/src.git && \
    echo "target_os = ['android']" >> .gclient

# `--reset` (2026-10-26): przerwany build (SIGTERM, utrata łącza) potrafi
# zostawić zależność w połowie checkoutu -- git widzi wtedy "local changes"
# i gclient odmawia aktualizacji ("could not detach HEAD"), a pętla retry
# powtarza ten sam błąd 6 razy (złapane na third_party/fuzztest/src).
# W checkout mouncie nie ma zamierzonych zmian (wszystkie edycje idą do
# /srcbuild), więc reset przed aktualizacją jest bezpieczny; razem z -D
# usuwa też nieśledzone katalogi w zależnościach -- odtwarza je runhooks.
RUN --mount=type=cache,target=/repo/chromium,id=chromium-checkout-android \
    for i in 1 2 3 4 5 6; do \
        gclient sync --with_branch_heads --with_tags -D --reset -j4 --nohooks && exit 0; \
        echo "==> gclient sync nieudany (próba $i/6, prawdopodobnie HTTP 429 z googlesource.com) — retry za 45s..."; \
        sleep 45; \
    done; \
    echo "BŁĄD: gclient sync nie powiódł się po 6 próbach" && exit 1

WORKDIR /repo/chromium/src
RUN --mount=type=cache,target=/repo/chromium,id=chromium-checkout-android \
    gclient runhooks

# Prebuildowany Node.js (pobrany przez hook powyżej, third_party/node/...)
# potrafi wylądować bez bitu wykonywalności -- realnie zaobserwowane:
# ninja failuje ~60000 celów DevTools frontend na starcie z
# "PermissionError: [Errno 13] Permission denied: .../node-linux-x64/bin/node",
# mimo że git zwykle zachowuje tryb pliku. Naprawiane defensywnie zamiast
# szukać czy to gclient hook, czy warstwa kontenera zjada exec-bit.
RUN --mount=type=cache,target=/repo/chromium,id=chromium-checkout-android \
    find third_party/node -type f \( -name "node" -o -name "node.exe" \) -exec chmod +x {} + 2>/dev/null || true

# 4b. Git submodule'y -- `gclient sync` NIE inicjalizuje natywnych git
#     submodułów w drzewie chromium/src (np. v8/ zostaje kompletnie puste,
#     mimo że `git ls-tree HEAD v8` pokazuje poprawny gitlink -- zweryfikowane
#     ręcznie w kontenerze debug, także z `"managed": true` + `--revision`,
#     więc to nie kwestia --unmanaged). Submoduły to osobny, natywny
#     mechanizm gita, którego gclient tu w ogóle nie dotyka -- trzeba
#     `git submodule update --init` jawnie, inaczej GN gen wywali się na
#     brakujących plikach (np. v8/BUILD.gn) niezależnie od stanu patchy.
#
#     .gitmodules ma 257 wpisów, część opatrzona `gclient-condition`
#     (składnia identyczna z warunkami w DEPS -- proste wyrażenie
#     bool na zmiennych typu checkout_android/checkout_linux/
#     checkout_src_internal). Ewaluujemy to samodzielnie w Pythonie
#     (te same zmienne co ustawiamy dla siebie: checkout_android=True,
#     checkout_linux=True -- budujemy Android z hosta Linux --
#     checkout_android_prebuilts_build_tools=True; reszta, w tym
#     checkout_src_internal/checkout_ios/checkout_mac/checkout_win,
#     domyślnie False -- te submoduły są nieosiągalne bez wewnętrznych
#     poświadczeń Google albo po prostu nam niepotrzebne) i inicjalizujemy
#     tylko pasujące ~150 zamiast wszystkich 257 (część to platformy,
#     których nie budujemy).
RUN --mount=type=cache,target=/repo/chromium,id=chromium-checkout-android \
    python3 - <<'PYEOF' > /repo/submodule_paths.txt
import re
with open('.gitmodules') as f:
    content = f.read()
blocks = re.split(r'(?=^\[submodule)', content, flags=__import__('re').M)
env = {
    'checkout_android': True,
    'checkout_linux': True,
    'checkout_android_prebuilts_build_tools': True,
}
class DefaultFalse(dict):
    def __missing__(self, key):
        return False
ctx = DefaultFalse(env)
for b in blocks:
    if not b.strip().startswith('[submodule'):
        continue
    m_path = re.search(r'^\s*path\s*=\s*(.+)$', b, re.M)
    m_cond = re.search(r'^\s*gclient-condition\s*=\s*(.+)$', b, re.M)
    if not m_path:
        continue
    path = m_path.group(1).strip()
    ok = True
    if m_cond:
        try:
            ok = eval(m_cond.group(1).strip(), {'__builtins__': {}}, ctx)
        except Exception:
            ok = False
    if ok:
        print(path)
PYEOF
RUN --mount=type=cache,target=/repo/chromium,id=chromium-checkout-android \
    echo "==> Inicjalizuję $(wc -l < /repo/submodule_paths.txt) git submodułów (v8 i inne)..." && \
    for i in 1 2 3 4 5; do \
        git submodule update --init --depth 1 --jobs 4 -- $(cat /repo/submodule_paths.txt) && exit 0; \
        echo "==> git submodule update nieudane (próba $i/5, prawdopodobnie HTTP 429) -- retry za 30s..."; \
        sleep 30; \
    done; \
    echo "BŁĄD: git submodule update nie powiodło się po 5 próbach" && exit 1

# Retry z tego samego powodu co krok 1 (apt pobiera tu setki MB paczek).
RUN --mount=type=cache,target=/repo/chromium,id=chromium-checkout-android \
    for i in 1 2 3; do \
        yes | build/install-build-deps.sh --android --unsupported && exit 0; \
        echo "==> install-build-deps nieudane (próba $i/3, chwilowa przerwa sieci?) -- retry za 60s..."; \
        sleep 60; \
    done; \
    echo "BŁĄD: install-build-deps nie powiodło się po 3 próbach" && exit 1

# ==============================================================================
# 4c. Trwały wolumen dla drzewa źródeł (/srcbuild) -- ninja z PRAWDZIWĄ
#     inkrementalnością między osobnymi wywołaniami `podman build`
# ==============================================================================
#     PROBLEM ZDIAGNOZOWANY 2026-08-07 (sesja podbicia patchy ungoogled na
#     Android): każda poprawka błędu kompilacji znalezionego GŁĘBOKO w
#     ninja (np. na 93% z 60700 celów) wymaga zmiany pliku źródłowego W
#     KTÓRYMŚ WCZEŚNIEJSZYM kroku `RUN` -- a Podman/Buildah traktuje CAŁY
#     krok `RUN ninja ...` jako jedną, niepodzielną warstwę cache. Zmiana
#     czegokolwiek wcześniej unieważnia tę warstwę w CAŁOŚCI, więc ninja
#     musi zacząć liczyć cele od 0/60700 -- mimo że ccache (osobny,
#     trwały mount) przyspiesza REKOMPILACJĘ każdego pojedynczego pliku,
#     samo przejście przez cały graf (uruchomienie ccache-wrapped
#     kompilatora dla wszystkich 60700 celów, plus kroki Java/dex/
#     ProGuard specyficzne dla Androida, których ccache W OGÓLE nie
#     przyspiesza) kosztowało realnie 1-3h PRZY KAŻDEJ poprawce w tej
#     sesji -- cztery pełne przebiegi ninja jednego dnia.
#
#     PRZYCZYNA (nie tylko "Podman jest wolny"): `chromium/src` żyje w
#     warstwach obrazu -- każdy nowy krok `RUN` to NOWA warstwa nakładana
#     na poprzednią. Gdy warstwa się zmienia, pliki źródłowe w niej
#     dostają ŚWIEŻY mtime (moment utworzenia warstwy), NIEZALEŻNIE od
#     tego, czy ich TREŚĆ faktycznie się zmieniła. Ninja decyduje "czy
#     kompilować ten .o" głównie po mtimie źródła vs zapisanego stanu w
#     `.ninja_log` -- świeży mtime na WSZYSTKICH plikach (nie tylko tym
#     jednym naprawionym) wygląda dla ninja jak "wszystko nowsze",
#     niezależnie od tego, że 99,99% plików ma bajt-w-bajt tę samą treść
#     co poprzednio.
#
#     FIX: `/srcbuild` -- cache mount (ten sam mechanizm co już istniejący
#     `/ccache`), TRWAŁY między osobnymi `podman build`, ale w
#     przeciwieństwie do zwykłych warstw obrazu -- pliki na nim NIE
#     dostają nowego mtime tylko dlatego, że wcześniejsza warstwa się
#     zmieniła. Od tego punktu w pliku (patche, fixy, literały,
#     domain_substitution, GN gen, ninja, pakowanie) WSZYSTKIE kroki
#     operują na `/srcbuild`, nie na `/repo/chromium/src` -- każdy z nich
#     MUSI mieć własną flagę `--mount=type=cache,target=/srcbuild,
#     id=chromium-src-android-hardened` (mount istnieje tylko w obrębie
#     JEDNEGO kroku `RUN`, trzeba go deklarować w każdym, dokładnie tak
#     jak już robimy dla `/ccache` w kroku ninja). Dzięki temu poprawka
#     JEDNEGO pliku (sed/python fix) daje mu JEDYNEMU nowy mtime -- ninja
#     przy następnym przebiegu przelicza tylko cele faktycznie zależne od
#     tego pliku (sekundy/minuty), zamiast przechodzić przez cały graf.
#
#     ZWERYFIKOWANE PRZED WDROŻENIEM (tani test poza tym repo, kilka
#     sekund, nie 90GB): osobny `Containerfile` z dwoma kolejnymi
#     `podman build` (drugi z inną wartością ARG wcześniej w pliku, żeby
#     wymusić cache miss na warstwie PRZED mountem) potwierdził: (1)
#     zawartość i mtime pliku w cache mouncie PRZETRWAŁY cache miss
#     wcześniejszej warstwy identyczne jak w pierwszym buildzie; (2)
#     `COPY --from=builder` w etapie `export` NIE WIDZI plików, które są
#     TYLKO w cache mouncie ("no such file or directory") -- dlatego
#     krok pakowania (8.) musi jawnie `cp` gotowy `.apk` z `/srcbuild` do
#     zwykłej, niemontowanej ścieżki `/output_apk/`, żeby `export` mógł
#     go zobaczyć.
#
#     JEDNORAZOWY KOSZT: pierwsze zasilenie `/srcbuild` kopiuje CAŁE
#     drzewo (`cp -a`, zachowuje mtime) z `/repo/chromium/src` -- to
#     tymczasowo DUBLUJE zużycie dysku (obie kopie istnieją, dopóki stare
#     warstwy nie zostaną wyczyszczone). Po tym jednorazowym koszcie
#     `/repo/chromium/src` (warstwy obrazu) staje się materiałem
#     WYŁĄCZNIE źródłowym dla zasilenia -- nic go już nie czyta.
#     ZASILENIE PRZY KAŻDYM WYKONANIU TEGO KROKU (od 2026-10-26; wcześniej
#     `if [ ! -d /srcbuild/.git ]` -- zasilenie raz w historii tego id).
#     Ten krok wykonuje się tylko przy cache missie warstw, czyli gdy coś
#     WCZEŚNIEJ się zmieniło: nowa wersja Chromium, zmiana kroków
#     fetch/sync, `podman image prune`. W każdym z tych przypadków stare
#     `/srcbuild` jest złe: inna wersja albo już załatane drzewo, na które
#     `patches.py apply` (nieidempotentne) nałożyłoby patche drugi raz
#     i padło (złapane na żywo 2026-08-07). Dlatego: wyczyść i skopiuj od
#     nowa. Gdy nic wcześniej się nie zmieniło, krok jest cache-hitem, nie
#     wykonuje się, a `/srcbuild` zachowuje stan ninja -- poprawki PO
#     patchach (fixy, literały, GN, ninja) nadal są inkrementalne.
#     `/srcbuild/.srcbuild_tag` = wersja, z której zasilono (diagnostyka).
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    --mount=type=cache,target=/repo/chromium,id=chromium-checkout-android \
    if [ -n "$(ls -A /srcbuild 2>/dev/null)" ]; then \
        echo "==> Czyszczę poprzednie /srcbuild ($(cat /srcbuild/.srcbuild_tag 2>/dev/null || echo 'wersja nieznana'), $(du -sh /srcbuild | cut -f1))..." && \
        find /srcbuild -mindepth 1 -delete; \
    fi && \
    echo "==> Zasilenie /srcbuild z /repo/chromium/src ($(cat /repo/chromium_tag.txt), kilka minut)..." && \
    cp -a /repo/chromium/src/. /srcbuild/ && \
    cp /repo/chromium_tag.txt /srcbuild/.srcbuild_tag && \
    echo "==> Zasilenie gotowe: $(du -sh /srcbuild | cut -f1)"

WORKDIR /srcbuild

# ==============================================================================
# Sekcje 5 / 5a / 5b / 5c USUNIĘTE (2026-08-07/08): nałożenie 330 patchy
# Cromite (`COPY cromite/`, `ARG WITH_CROMITE`, pętla `git am`) + pomocniczy
# split_patch.py (rozbijanie patchy dotykających submodułów) + dwie naprawy
# SKUTKÓW patchy Cromite (webnn:buildflags, skills/proto) -- wszystkie cztery
# istniały WYŁĄCZNIE po to, żeby obsłużyć Cromite. Numeracja "5d/5e/5f"
# niżej ZOSTAJE nietknięta (nie przenumerowana na 5/5a/5b), żeby nie rozjechać
# się z historią zmian, która się do niej odwołuje.
#
# ARG VARIANT (ungoogled|vanilla) steruje wszystkim od tego punktu w dół --
# kroki fetch/gclient sync/submoduły/install-build-deps/zasilenie /srcbuild
# są wspólne i współdzielą cache warstw między wariantami, dlatego ARG jest
# zadeklarowany dopiero TUTAJ, a nie na górze pliku (ten sam wzorzec co
# poprzednio dla WITH_CROMITE).
# ==============================================================================
ARG VARIANT=ungoogled

# 5d. WARIANT UTWARDZONY: pełna seria WŁASNYCH patchy ungoogled-chromium
# ==============================================================================
#     To NIE jest Plan A (330 patchy Cromite, fingerprinting/adblock, 48%
#     nakłada się na 151.x, 134 wymaga realnej analizy). Patche ungoogled to
#     INNY, dużo mniejszy zestaw (108, katalog `patches/`, plik `series`
#     określa kolejność) -- głównie usuwanie brandingu/integracji z Google
#     (GAIA, wyszukiwarka domyślna, domain reliability, WebRTC log uploader,
#     translate itd.), nie mitygacje fingerprintingu.
#
#     ZMIERZONE PRZED WDROŻENIEM (poza kontenerem, na płytkim klonie drzewa): **108/108 (100%) nakłada się czysto** na drzewo Android
#     151.0.7922.71 (jedyny pozorny FAIL to fałszywy negatyw -- brakujący
#     submoduł w tanim środowisku testowym, po doklejeniu przechodzi też).
#     Zastosowane przez oficjalny `utils/patches.py` (system `patch -p1`,
#     NIE `git am`/`git apply` -- `patch` operuje na plikach, więc submoduły
#     gitlinkowane (v8 itd.) nie są problemem, w odróżnieniu od Cromite,
#     gdzie to wymagało `split_patch.py`).
#
#     ŚWIADOMA DECYZJA: część patchy zmienia widoczne, codzienne
#     zachowanie (np. `replace-google-search-engine-with-nosearch.patch`
#     podmienia domyślną wyszukiwarkę na placeholder -- pasek adresu
#     przestaje wyszukiwać, dopóki użytkownik ręcznie nie ustawi innej).
#     To zgodne z zachowaniem buildów desktopowych (cel "ujednolicenia"), ale to nie
#     cichy literał jak sekcja 5e niżej -- świadomie zaakceptowane.
#
#     Kolejność jak na desktopie (krok 7 Containerfile): patche PRZED
#     domain_substitution (sekcja 5f) -- część patchy dodaje/usuwa tekst,
#     który domain_substitution potem przetwarza w tym samym przebiegu.
RUN if [ "${VARIANT}" != "ungoogled" ]; then echo "==> Wariant ${VARIANT}: pomijam patche ungoogled-chromium"; exit 0; fi; \
    UC_TAG=$(cat /repo/uc_tag.txt) && \
    echo "==> Klonuję ungoogled-chromium ${UC_TAG} (patche + listy domain_substitution; ten sam tag co źródła Chromium, krok 3)" && \
    git clone --branch "${UC_TAG}" --depth 1 \
        https://github.com/ungoogled-software/ungoogled-chromium.git /repo/ungoogled-domsub

#     WYKLUCZENIE DWÓCH PATCHY (znalezione po TRZECH iteracjach diagnozy): `core/inox-patchset/0001-fix-
#     building-without-safebrowsing.patch` i `core/ungoogled-chromium/
#     fix-building-without-safebrowsing.patch` razem usuwają z drzewa
#     KOMPLETNY target `chrome/browser/safe_browsing` i setki wystąpień
#     `#include ".../safe_browsing_prefs.h"` w całym drzewie. To NIE jest
#     przypadek "is_android, którego ungoogled nie testuje" -- to patche
#     zaprojektowane jako PARA z flagą GN `safe_browsing_mode=0`
#     (dosłownie obecną w `flags.gn` ungoogled-chromium). MY tej flagi
#     ŚWIADOMIE nie ustawiamy (patrz wyżej w tym pliku: `safe_browsing_
#     mode=0` przechodzi `gn gen`, ale wywala ninja po ~26000 targetów
#     przez `cloud_content_scanning`, zawsze budowany na Androidzie).
#     Bez tej flagi te dwa patche zostawiają drzewo w NIESPÓJNYM stanie:
#     nagłówek i jego build-target usunięte, ale dziesiątki plików (m.in.
#     `password_protection_service_base.cc`, `client_side_detection_
#     service.cc` -- NIE Android-specyficzne, zwykły cross-platformowy
#     kod) nadal odwołują się do jego symboli -> `undeclared identifier`
#     w ninja. Zweryfikowane host-side: po wykluczeniu tych 2 wpisów z
#     `series` `chrome/browser/safe_browsing/BUILD.gn` wraca do
#     NIEZMIENIONEJ (upstream) postaci (zero `if (false)`), a
#     `chrome/browser/BUILD.gn` odzyskuje zależności `//chrome/browser/
#     safe_browsing` -- struktura identyczna jak w zwykłym, kompilowalnym
#     Chromium. Nasz własny literal (sekcja 5e, `kSafeBrowsingEnabled`)
#     nietknięty i nadal zadziała normalnie -- to jedyny mechanizm,
#     którego potrzebujemy, żeby Safe Browsing był domyślnie wyłączony.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cd /repo/ungoogled-domsub && \
    grep -v "fix-building-without-safebrowsing" patches/series > /tmp/series_filtered && \
    mv /tmp/series_filtered patches/series && \
    if grep -q '^  inputs = \[$' /srcbuild/components/domain_reliability/BUILD.gn 2>/dev/null && \
       grep -A1 '^  inputs = \[$' /srcbuild/components/domain_reliability/BUILD.gn | grep -q '^  \]$'; then \
        echo "==> Patche ungoogled-chromium już zaaplikowane na /srcbuild (spot-check: domain_reliability/BUILD.gn) -- pomijam (patches.py apply NIE jest idempotentne)"; \
    else \
        echo "==> Aplikuję $(grep -vc '^$' patches/series) patchy ungoogled-chromium (wykluczone: 2x fix-building-without-safebrowsing, wymagają safe_browsing_mode=0, którego nie ustawiamy)..." && \
        python3 utils/patches.py apply /srcbuild patches && \
        grep -q '^  inputs = \[$' /srcbuild/components/domain_reliability/BUILD.gn && \
        grep -A1 '^  inputs = \[$' /srcbuild/components/domain_reliability/BUILD.gn | grep -q '^  \]$' || \
            (echo "BŁĄD: patche ungoogled nie zaaplikowały się poprawnie (spot-check: domain_reliability/BUILD.gn)" && exit 1); \
    fi

# BŁĄD ZŁAPANY W NINJA (piąty przypadek wzorca is_android-untested, ale
# pierwszy będący prawdziwym błędem KOMPILACJI C++, nie GN): `extra/
# ungoogled-chromium/add-suggestions-url-field.patch` dodaje 5. parametr
# (`suggestions_url`) do `TemplateURLService::ResetTemplateURL` i
# aktualizuje WSZYSTKIE wywołania w desktopowym UI (chrome://settings/
# searchEngines) -- ale `components/search_engines/android/
# template_url_service_android.cc` (JNI bridge dla ANDROIDOWEGO UI
# wyszukiwarek, zupełnie inna ścieżka kodu niż desktopowe WebUI) ma
# WŁASNE 2 wywołania tej samej funkcji, których autor patcha nie dotknął
# (nie buduje na Androida). Efekt: `too few arguments to function call,
# expected 5, have 4` w dwóch miejscach. Fix: dopisać brakujący argument
# `suggestions_url()` istniejącego obiektu (Android UI nie ma pola do
# EDYCJI suggestions_url, więc zachowujemy wartość bieżącą, nie zmieniamy
# zachowania) -- w PRAWIDŁOWEJ pozycji (5. argument, po `search_url`, nie
# przed -- pierwsza wersja tego fixa miała złą kolejność, złapane przy
# review przed wdrożeniem, nie w buildzie).
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cd /srcbuild && \
    F=components/search_engines/android/template_url_service_android.cc && \
    (grep -q "regulatory_api_turl->suggestions_url());" "$F" || \
     (grep -q "regulatory_api_turl->keyword(), regulatory_api_turl->url());" "$F" && \
      sed -i 's/regulatory_api_turl->keyword(), regulatory_api_turl->url());/regulatory_api_turl->keyword(), regulatory_api_turl->url(),\n          regulatory_api_turl->suggestions_url());/' "$F")) && \
    grep -q "regulatory_api_turl->suggestions_url());" "$F" && \
    (grep -q "search_url, template_url->suggestions_url());" "$F" || \
     (grep -q "^                                          search_url);$" "$F" && \
      sed -i 's/^                                          search_url);$/                                          search_url, template_url->suggestions_url());/' "$F")) && \
    grep -q "search_url, template_url->suggestions_url());" "$F" || \
        (echo "BŁĄD: fix template_url_service_android.cc (suggestions_url) się nie zaaplikował" && exit 1)

# BŁĄD ZŁAPANY W NINJA -- INNY WZORZEC niż poprzednie pięć (nie
# is_android, nie brakująca flaga GN): `remove-unused-preferences-fields.
# patch` usuwa `#include ".../safe_browsing_prefs.h"` z **95 plików**
# jednocześnie (zweryfikowane sparsowaniem samego patcha, nie zgadywane).
# Wiele z nich (m.in. `sb_protocol_manager_util.h`,
# `device_signals/core/browser/browser_utils.h`) używało tego nagłówka
# TRANZYTYWNIE -- same nie deklarowały, skąd biorą `safe_browsing::`,
# `prefs::kSafeBrowsing*`, `base::FeatureList` itd., tylko polegały na
# tym, że coś innego w łańcuchu include'ów to zapewniało. Pierwsze dwa
# złapane pojedynczo w kolejnych buildach (sb_protocol_manager_util.cc,
# potem browser_utils.h) ujawniły wzorzec zbyt duży na pojedyncze sedy --
# zamiast łapać kolejne z 95 plików jeden po jednym w osobnych,
# wielogodzinnych próbach builda, poniższy skrypt sprawdza WSZYSTKIE 95
# NA RAZ: dla każdego pliku, który wciąż (po tym i INNYCH patchach)
# odwołuje się do symboli z tego nagłówka (`safe_browsing::`,
# `prefs::kSafeBrowsing*`, `prefs::kPasswordProtection*`,
# `IsSafeBrowsingEnabled(` itd.), dopisuje `#include` z powrotem --
# reszta (te, których patch poprawnie oczyścił z użycia) zostaje bez
# zmian. Zweryfikowane poza kontenerem, na płytkim klonie drzewa:
# 58 z 95 faktycznie potrzebowało przywrócenia, 37 nie (patch je
# kompletnie wyczyścił, żadnego odwołania nie zostało). Kolejność
# includów w wynikowych plikach nie jest idealnie alfabetyczna (nie ma to
# znaczenia dla kompilacji, tylko dla lintera stylu, którego tu nie
# uruchamiamy). Bezpieczne również dla plików nigdy niekompilowanych na
# Androidzie (część z 95 to desktop-only UI) -- przywrócenie nieużywanego
# include'a jest no-opem, nie błędem.
RUN if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cat > /repo/fix_safe_browsing_prefs_includes.py <<'PYEOF'
#!/usr/bin/env python3
"""Przywraca '#include safe_browsing_prefs.h' tam, gdzie remove-unused-
preferences-fields.patch go usunął, ale plik nadal odwołuje się do
symboli, które ten naglowek (tranzytywnie) zapewniał -- zweryfikowane
per-plik, nie przywracane wszędzie na slepo."""
import sys
from pathlib import Path

SRC = Path(sys.argv[1] if len(sys.argv) > 1 else "/srcbuild")
INCLUDE_LINE = '#include "components/safe_browsing/core/common/safe_browsing_prefs.h"'

FILES = """chrome/browser/chrome_content_browser_client.cc
chrome/browser/content_settings/generated_javascript_optimizer_pref.cc
chrome/browser/download/download_browsertest.cc
chrome/browser/download/download_ui_model.cc
chrome/browser/download/download_ui_safe_browsing_util.cc
chrome/browser/enterprise/connectors/analysis/content_analysis_delegate.cc
chrome/browser/enterprise/signals/context_info_fetcher.h
chrome/browser/extensions/api/preference/preference_api.cc
chrome/browser/extensions/api/preference/preference_apitest.cc
chrome/browser/extensions/api/safe_browsing_private/safe_browsing_private_event_router.cc
chrome/browser/extensions/api/safe_browsing_private/safe_browsing_private_event_router_unittest.cc
chrome/browser/extensions/api/settings_private/prefs_util.cc
chrome/browser/extensions/extension_service.cc
chrome/browser/extensions/installed_loader.cc
chrome/browser/extensions/pref_mapping.cc
chrome/browser/notifications/platform_notification_service_impl.cc
chrome/browser/password_manager/generated_password_leak_detection_pref.cc
chrome/browser/policy/configuration_policy_handler_list_factory.cc
chrome/browser/prefs/browser_prefs.cc
chrome/browser/prefs/chrome_command_line_pref_store.cc
chrome/browser/prefs/chrome_pref_service_factory.cc
chrome/browser/prefs/pref_functional_browsertest.cc
chrome/browser/safe_browsing/advanced_protection_status_manager_desktop.cc
chrome/browser/safe_browsing/advanced_protection_status_manager_unittest.cc
chrome/browser/safe_browsing/android/services_delegate_android.h
chrome/browser/safe_browsing/chrome_password_protection_service.cc
chrome/browser/safe_browsing/chrome_password_protection_service_browsertest.cc
chrome/browser/safe_browsing/chrome_password_protection_service_sync_browsertest.cc
chrome/browser/safe_browsing/download_protection/check_client_download_request.cc
chrome/browser/safe_browsing/download_protection/check_client_download_request_base.cc
chrome/browser/safe_browsing/download_protection/download_protection_service_unittest.cc
chrome/browser/safe_browsing/incident_reporting/extension_data_collection_unittest.cc
chrome/browser/safe_browsing/incident_reporting/incident_reporting_service.cc
chrome/browser/safe_browsing/incident_reporting/incident_reporting_service_unittest.cc
chrome/browser/safe_browsing/incident_reporting/last_download_finder_unittest.cc
chrome/browser/safe_browsing/incident_reporting/state_store.cc
chrome/browser/safe_browsing/incident_reporting/state_store_unittest.cc
chrome/browser/safe_browsing/metrics/safe_browsing_metrics_provider.cc
chrome/browser/safe_browsing/safe_browsing_blocking_page_test.cc
chrome/browser/safe_browsing/safe_browsing_service.h
chrome/browser/safe_browsing/telemetry/android/android_telemetry_service.cc
chrome/browser/safe_browsing/telemetry/android/android_telemetry_service_unittest.cc
chrome/browser/safe_browsing/url_checker_delegate_impl.cc
chrome/browser/site_protection/site_familiarity_utils.cc
chrome/browser/ssl/sct_reporting_service.cc
chrome/browser/ssl/ssl_browsertest.cc
chrome/browser/ssl/ssl_error_controller_client.cc
chrome/browser/ui/hats/trust_safety_sentiment_service.cc
chrome/browser/ui/safety_hub/menu_notification_service.cc
chrome/browser/ui/safety_hub/safe_browsing_result.cc
chrome/browser/ui/views/download/bubble/download_toolbar_ui_controller.cc
chrome/browser/ui/webui/browser_command/browser_command_handler.cc
chrome/browser/ui/webui/downloads/downloads_dom_handler.cc
chrome/browser/ui/webui/management/management_ui_handler.cc
chrome/browser/ui/webui/reset_password/reset_password_ui.cc
chrome/browser/ui/webui/settings/safety_hub_handler.cc
chrome/browser/ui/webui/settings/settings_localized_strings_provider.cc
chrome/browser/unified_consent/unified_consent_service_factory.cc
components/device_signals/core/browser/browser_utils.h
components/password_manager/core/browser/leak_detection/leak_detection_check_impl.cc
components/password_manager/core/browser/leak_detection_delegate.cc
components/password_manager/core/browser/password_reuse_detector_impl.cc
components/password_manager/core/browser/password_reuse_manager_impl.cc
components/password_manager/core/browser/password_sync_util.cc
components/password_manager/core/browser/store_metrics_reporter.cc
components/password_manager/core/browser/sync_credentials_filter_unittest.cc
components/safe_browsing/content/browser/base_blocking_page.cc
components/safe_browsing/content/browser/client_side_detection_service.cc
components/safe_browsing/content/browser/safe_browsing_navigation_observer_manager.cc
components/safe_browsing/content/browser/triggers/suspicious_site_trigger_unittest.cc
components/safe_browsing/content/browser/triggers/trigger_manager.cc
components/safe_browsing/content/browser/triggers/trigger_throttler_unittest.cc
components/safe_browsing/content/browser/ui_manager.cc
components/safe_browsing/content/browser/ui_manager_unittest.cc
components/safe_browsing/core/browser/db/sb_protocol_manager_util.h
components/safe_browsing/core/browser/db/util.h
components/safe_browsing/core/browser/password_protection/password_protection_service_base.h
components/safe_browsing/core/browser/realtime/policy_engine.cc
components/safe_browsing/core/browser/realtime/url_lookup_service.cc
components/safe_browsing/core/browser/realtime/url_lookup_service_base.cc
components/safe_browsing/core/browser/safe_browsing_metrics_collector.cc
components/safe_browsing/core/browser/tailored_security_service/tailored_security_service.cc
components/safe_browsing/core/browser/tailored_security_service/tailored_security_service_observer_util.cc
components/safe_browsing/core/common/hashprefix_realtime/hash_realtime_utils.cc
components/safe_browsing/core/common/safe_browsing_policy_handler.cc
components/safe_browsing/core/common/safe_browsing_prefs_unittest.cc
components/safety_check/safety_check.cc
components/security_interstitials/content/bad_clock_blocking_page.cc
components/security_interstitials/content/captive_portal_blocking_page.cc
components/security_interstitials/content/mitm_software_blocking_page.cc
components/security_interstitials/content/security_interstitial_controller_client.cc
components/security_interstitials/content/security_interstitial_page.cc
components/security_interstitials/content/ssl_blocking_page.cc
components/sync_preferences/common_syncable_prefs_database.cc
extensions/browser/extension_allowlist.cc""".splitlines()

# PORZUCONA HEURYSTYKA (pierwsza wersja tego skryptu): próba zgadnięcia,
# które z 95 plików NADAL potrzebują include'a przez grep wzorców takich
# jak "safe_browsing::"/"GetPasswordProtectionWarningTrigger(" w treści
# pliku -- dała fałszywy negatyw: `password_protection_service_base.h`
# deklaruje typy z namespace `safe_browsing` BEZ kwalifikatora (bo sam
# plik jest wewnątrz `namespace safe_browsing {...}`), więc żaden wzorzec
# z prefiksem "safe_browsing::" nie pasował, mimo że nagłówek był
# potrzebny -- ninja padł na `GetPasswordProtectionWarningTriggerPref`
# (z sufiksem "Pref", którego wzorzec też nie łapał) w .cc, które
# TRANZYTYWNIE zależy od tego samego brakującego include'a przez własny
# .h. Zamiast łatać wzorce w nieskończoność: przywracamy WSZYSTKIM 95
# plikom bezwarunkowo -- nieużywany include nie jest błędem kompilacji
# (`treat_warnings_as_errors=false` w naszych GN_ARGS i tak by to
# tolerował, gdyby kiedykolwiek było inaczej), więc nadmiarowe
# przywrócenie jest nieszkodliwe, a eliminuje całą klasę fałszywych
# negatywów tej heurystyki.
fixed, skipped_missing, skipped_has_include = [], [], []

for rel in FILES:
    p = SRC / rel
    if not p.exists():
        skipped_missing.append(rel)
        continue
    text = p.read_text(encoding="utf-8", errors="ignore")
    if INCLUDE_LINE in text:
        skipped_has_include.append(rel)
        continue
    lines = text.split("\n")
    last_include_idx = None
    for i, line in enumerate(lines[:80]):
        if line.startswith("#include"):
            last_include_idx = i
    if last_include_idx is None:
        skipped_missing.append(rel + " (brak #include na poczatku -- pominieto)")
        continue
    lines.insert(last_include_idx + 1, INCLUDE_LINE)
    p.write_text("\n".join(lines), encoding="utf-8")
    fixed.append(rel)

print(f"NAPRAWIONE: {len(fixed)}, POMINIETE (ma juz include): {len(skipped_has_include)}, "
     f"POMINIETE (brak pliku/struktury): {len(skipped_missing)}")
# Sanity floor liczy SUME "naprawione TERAZ" + "mial juz wczesniej" -- na
# /srcbuild (trwaly mount) ten skrypt moze sie wykonac ponownie na juz
# poprawionym drzewie (np. po wstawieniu nowego fixu wczesniej w pliku,
# co uniewaznia cache tego kroku) i wtedy PRAWIDLOWO naprawia 0, bo
# wszystkie 95 juz maja include -- to nie jest blad.
if len(fixed) + len(skipped_has_include) < 85:
    print("BŁĄD: ani naprawiono, ani już obecnych w wystarczającej liczbie plików -- sprawdź ręcznie", file=sys.stderr)
    sys.exit(1)
PYEOF

RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    python3 /repo/fix_safe_browsing_prefs_includes.py /srcbuild

# BŁĄD ZŁAPANY W NINJA -- INNY WZORZEC niż brakujący include (dziewiąty
# przypadek w tej sesji): `remove-unused-preferences-fields.patch` usuwa
# CZYSTĄ WIRTUALNĄ metodę `GetPasswordProtectionWarningTriggerPref`
# z klasy `PasswordProtectionServiceBase` (razem z jej deklaracją, nie
# tylko include), ale NIE aktualizuje 3 miejsc, które ją wołają:
# `PasswordProtectionServiceBase::IsWarningEnabled` (ta sama klasa) oraz
# `ChromePasswordProtectionService::IsInPasswordAlertMode` i
# `::GetPingNotSentReason` (podklasa) -- `use of undeclared identifier`.
# Zweryfikowane grepem całego drzewa (poza testami/mockami, których nie
# kompilujemy): to WSZYSTKIE 3 miejsca, żadnej implementacji przesłaniającej
# gdzie indziej nie zostało. To rzeczywista luka w samym patchu ungoogled
# (nie jest to_android-specyficzne ani sparowane z flagą GN) -- usunięto
# mechanizm odczytu preferencji, ale zostawiono trzy odwołania do niego.
# Fix: skoro mechanizm konfigurowania progu ostrzeżenia został usunięty,
# traktujemy go jako "zawsze wyłączony" (spójne z resztą tej sesji --
# mniej gadatliwe ostrzeżenia o ponownym użyciu haseł, nie więcej) --
# wszystkie 3 miejsca zwracają teraz efekt "wyłączone" bezpośrednio,
# zamiast odpytywać nieistniejącą metodę. Zweryfikowane poza
# kontenerem (płytki klon drzewa) przez dokładne dopasowanie
# tekstu (asercja unikalności przed podmianą, nie zgadywane sed-y).
RUN if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cat > /repo/fix_password_protection_trigger.py <<'PYEOF'
#!/usr/bin/env python3
"""remove-unused-preferences-fields.patch usuwa GetPasswordProtectionWarningTriggerPref
(czysta wirtualna metoda) z klasy, ale zostawia 3 wywolania. Traktujemy
usuniety mechanizm jako zawsze wylaczony."""
import sys
from pathlib import Path

SRC = Path(sys.argv[1] if len(sys.argv) > 1 else "/srcbuild")

f1 = SRC / "components/safe_browsing/core/browser/password_protection/password_protection_service_base.cc"
old1 = """bool PasswordProtectionServiceBase::IsWarningEnabled(
    ReusedPasswordAccountType password_type) {
  return GetPasswordProtectionWarningTriggerPref(password_type) ==
         PHISHING_REUSE;
}"""
new1 = """bool PasswordProtectionServiceBase::IsWarningEnabled(
    ReusedPasswordAccountType password_type) {
  return false;
}"""
text1 = f1.read_text()
if new1 in text1:
    print("fix1 (IsWarningEnabled) juz zastosowany, pomijam")
else:
    assert text1.count(old1) == 1, f"fix1: {text1.count(old1)} wystapien zamiast 1"
    f1.write_text(text1.replace(old1, new1))
    print("fix1 (IsWarningEnabled) OK")

f2 = SRC / "chrome/browser/safe_browsing/chrome_password_protection_service.cc"
text2 = f2.read_text()

old2 = """bool ChromePasswordProtectionService::IsInPasswordAlertMode(
    ReusedPasswordAccountType password_type) {
  return GetPasswordProtectionWarningTriggerPref(password_type) ==
         PASSWORD_REUSE;
}"""
new2 = """bool ChromePasswordProtectionService::IsInPasswordAlertMode(
    ReusedPasswordAccountType password_type) {
  return false;
}"""
if new2 in text2:
    print("fix2 (IsInPasswordAlertMode) juz zastosowany, pomijam")
else:
    assert text2.count(old2) == 1, f"fix2: {text2.count(old2)} wystapien zamiast 1"
    text2 = text2.replace(old2, new2)

old3 = """  if (trigger_type == LoginReputationClientRequest::PASSWORD_REUSE_EVENT &&
      GetPasswordProtectionWarningTriggerPref(password_type) ==
          PASSWORD_PROTECTION_OFF) {
    return RequestOutcome::TURNED_OFF_BY_ADMIN;
  }"""
new3 = """  if (trigger_type == LoginReputationClientRequest::PASSWORD_REUSE_EVENT) {
    return RequestOutcome::TURNED_OFF_BY_ADMIN;
  }"""
if new3 in text2:
    print("fix3 (GetPingNotSentReason) juz zastosowany, pomijam")
else:
    assert text2.count(old3) == 1, f"fix3: {text2.count(old3)} wystapien zamiast 1"
    text2 = text2.replace(old3, new3)

f2.write_text(text2)
print("fix2+3 (IsInPasswordAlertMode, GetPingNotSentReason) OK")
PYEOF

RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    python3 /repo/fix_password_protection_trigger.py /srcbuild

# BŁĄD ZŁAPANY W NINJA -- BEZPOŚREDNIA KONSEKWENCJA wykluczenia
# `fix-building-without-safebrowsing.patch` (11. przypadek): `core/
# ungoogled-chromium/move-js-optimizer-unfamiliar-sites.patch` PRZENOSI
# stałą `kJavascriptOptimizerBlockedForUnfamiliarSites` z
# `safe_browsing_prefs.h` do `content_settings/core/common/pref_names.h`
# -- ale ten patch tylko DODAJE nową deklarację w nowym miejscu, USUNIĘCIE
# starej z `safe_browsing_prefs.h` siedziało w drugiej połowie tej samej
# "przeprowadzki", zaszytej w WYKLUCZONYM `fix-building-without-
# safebrowsing.patch`. Efekt: po naszym bezwarunkowym przywróceniu
# `#include safe_browsing_prefs.h` do 95 plików (krok wyżej),
# `site_familiarity_utils.cc` (który już includuje `pref_names.h`)
# dostaje TĘ SAMĄ stałą zadeklarowaną DWA razy -> `redefinition of
# 'kJavascriptOptimizerBlockedForUnfamiliarSites'`. Zweryfikowane przez
# `git show <tag>:plik` na czystym, niepatchowanym drzewie: w oryginale
# stała istnieje TYLKO w `safe_browsing_prefs.h` -- duplikat wprowadziła
# kombinacja naszych własnych decyzji (zastosuj `move-*`, wyklucz
# `fix-building-without-safebrowsing`), nie błąd pojedynczego patcha.
# Fix: dokończyć przeprowadzkę ręcznie -- usunąć starą deklarację z
# `safe_browsing_prefs.h`, zostawiając jedyną (już poprawną) kopię w
# `pref_names.h`. Sprawdzone programowo (nie na oko), że to JEDYNA taka
# kolizja między tymi dwoma nagłówkami (brak innych wspólnych symboli
# `kXxx`) -- nie ma potrzeby szerszego audytu.
RUN if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cat > /repo/fix_js_optimizer_pref_duplicate.py <<'PYEOF'
#!/usr/bin/env python3
"""move-js-optimizer-unfamiliar-sites.patch przenosi stala do pref_names.h,
ale usuniecie starej deklaracji z safe_browsing_prefs.h nalezalo do
wykluczonego fix-building-without-safebrowsing.patch. Konczymy przeprowadzke
recznie."""
import sys
from pathlib import Path

SRC = Path(sys.argv[1] if len(sys.argv) > 1 else "/srcbuild")
f = SRC / "components/safe_browsing/core/common/safe_browsing_prefs.h"
text = f.read_text()
old = """// A boolean indicating whether the user selected on chrome://settings to
// disable the JavaScript optimizer on unfamiliar sites for improved security.
// The site-familiarity computation is done locally based on the user's
// browsing habits.
inline constexpr char kJavascriptOptimizerBlockedForUnfamiliarSites[] =
    "safebrowsing.javascript_optimizer_blocked_for_unfamiliar_sites";

"""
count = text.count(old)
if count == 0:
    print("duplikat kJavascriptOptimizerBlockedForUnfamiliarSites juz usuniety, pomijam")
else:
    assert count == 1, f"oczekiwano 1 wystapienia, znaleziono {count}"
    f.write_text(text.replace(old, ""))
    print("duplikat kJavascriptOptimizerBlockedForUnfamiliarSites usuniety z safe_browsing_prefs.h")
PYEOF

RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    python3 /repo/fix_js_optimizer_pref_duplicate.py /srcbuild

# BŁĄD ZŁAPANY W NINJA (12. przypadek) -- TA SAMA rodzina co ósmy/dziewiąty
# przypadek (kruchy include, nie duplikat, nie is_android): w
# `chrome/browser/policy/configuration_policy_handler_list_factory.cc`
# `remove-unused-preferences-fields.patch` usuwa `#include ".../
# safe_browsing_policy_handler.h"` ZAŁOŻENIE: wszystkie odwołania do
# `safe_browsing::SafeBrowsingPolicyHandler` w tym pliku i tak znikną --
# ale TO założenie jest prawdziwe tylko razem z WYKLUCZONYM `fix-building-
# without-safebrowsing.patch`, który usuwa JEDYNE pozostałe wywołanie
# (`handlers->AddHandler(std::make_unique<safe_browsing::
# SafeBrowsingPolicyHandler>())`). Zweryfikowane: WSZYSTKIE inne symbole z
# `safe_browsing_prefs.h` (`prefs::kSafeBrowsing*` itd.) w tym samym pliku
# są usuwane przez TEN SAM (zaaplikowany) patch -- więc plik potrzebuje z
# powrotem WYŁĄCZNIE `safe_browsing_policy_handler.h`, nie
# `safe_browsing_prefs.h` (stąd ten plik nie był i nie powinien być na
# liście 95 wyżej). Ten sam ogólny wzorzec co jedenasty przypadek:
# wykluczenie patcha zostawia osierocone pół-zmiany z INNYCH, wciąż
# aplikowanych patchy w tym samym pliku.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cd /srcbuild && \
    F=chrome/browser/policy/configuration_policy_handler_list_factory.cc && \
    (grep -q '#include "components/safe_browsing/core/common/safe_browsing_policy_handler.h"' "$F" || \
     (grep -q '#include "components/safe_browsing/buildflags.h"' "$F" && \
      sed -i 's|#include "components/safe_browsing/buildflags.h"|#include "components/safe_browsing/buildflags.h"\n#include "components/safe_browsing/core/common/safe_browsing_policy_handler.h"|' "$F")) && \
    grep -q '#include "components/safe_browsing/core/common/safe_browsing_policy_handler.h"' "$F" || \
        (echo "BŁĄD: fix configuration_policy_handler_list_factory.cc (safe_browsing_policy_handler.h) się nie zaaplikował" && exit 1)

# BŁĄD ZŁAPANY W NINJA (13. przypadek) -- ODWROTNOŚĆ dwunastego: tam patch
# USUWAŁ include, którego wciąż potrzebowano; tu `extra/ungoogled-chromium/
# add-flag-to-configure-extension-downloading.patch` DODAJE `#include
# "extensions/browser/extension_util.h"` do `chrome/browser/download/
# download_target_determiner.cc`, ale POZA istniejącym blokiem `#if
# BUILDFLAG(ENABLE_EXTENSIONS_CORE)` -- mimo że jedyne miejsce w tym pliku,
# gdzie patch faktycznie UŻYWA tego nagłówka (wywołanie
# `extensions::util::ShouldDownloadAsRegularFile()`), samo jest wewnątrz
# tego bloku. Na Androidzie `enable_extensions_core` jest DOMYŚLNIE `false`
# (`extensions/buildflags/buildflags.gni`: `enable_extensions =
# !is_android && ...`, `enable_extensions_core = enable_extensions || ...`)
# -- więc otoczony kodem include nigdy by się nie skompilował, ale
# bezwarunkowy się kompiluje zawsze, a `extensions/common/manifest.h`
# (tranzytywnie, przez `extension_util.h`) wymaga wygenerowanego
# `extensions/common/mojom/manifest.mojom-shared.h`, którego target
# `chrome/browser/download:impl` nie ma w deps na Androidzie (nigdy nie
# musiał). Efekt: `fatal error: ... manifest.mojom-shared.h file not
# found`. To błąd w SAMYM patchu ungoogled (dwa pozostałe includy w tym
# samym bloku -- `webstore_installer.h`, `feature_switch.h` -- SĄ
# poprawnie zagatowane, autor patcha po prostu umieścił nowy include nad
# blokiem zamiast w nim), niewidoczny na desktopie (tam
# `enable_extensions=true`, nagłówek zawsze dostępny). Zweryfikowane
# host-side: przeniesienie include'a do bloku `#if
# BUILDFLAG(ENABLE_EXTENSIONS_CORE)` nie zmienia zachowania (kod, który go
# używa, i tak jest w tym samym bloku) i usuwa błąd kompilacji.
RUN if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cat > /repo/fix_download_target_determiner_include.py <<'PYEOF'
#!/usr/bin/env python3
"""add-flag-to-configure-extension-downloading.patch dodaje niezagatowany
#include extension_util.h, mimo ze jedyne uzycie jest pod
#if BUILDFLAG(ENABLE_EXTENSIONS_CORE) -- ktore na Androidzie jest false.
Przenosimy include do istniejacego bloku guard obok pokrewnych naglowkow."""
import sys
from pathlib import Path

SRC = Path(sys.argv[1] if len(sys.argv) > 1 else "/srcbuild")
f = SRC / "chrome/browser/download/download_target_determiner.cc"
text = f.read_text()

new_guarded_marker = ('#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)\n'
                      '#include "extensions/browser/extension_util.h"\n')
if new_guarded_marker in text:
    print("include extension_util.h juz przeniesiony pod guard, pomijam")
else:
    old_unconditional = ('#include "content/public/common/buildflags.h"\n'
                          '#include "extensions/browser/extension_util.h"\n'
                          '#include "extensions/buildflags/buildflags.h"\n')
    assert text.count(old_unconditional) == 1, f"oczekiwano 1, znaleziono {text.count(old_unconditional)}"
    text = text.replace(old_unconditional,
        '#include "content/public/common/buildflags.h"\n'
        '#include "extensions/buildflags/buildflags.h"\n')

    old_guarded = ('#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)\n'
                   '#include "extensions/browser/webstore_installer.h"\n'
                   '#include "extensions/common/feature_switch.h"\n'
                   '#endif\n')
    assert text.count(old_guarded) == 1, f"oczekiwano 1, znaleziono {text.count(old_guarded)}"
    text = text.replace(old_guarded,
        '#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)\n'
        '#include "extensions/browser/extension_util.h"\n'
        '#include "extensions/browser/webstore_installer.h"\n'
        '#include "extensions/common/feature_switch.h"\n'
        '#endif\n')

    f.write_text(text)
print("extension_util.h przeniesiony pod #if BUILDFLAG(ENABLE_EXTENSIONS_CORE) w download_target_determiner.cc")
PYEOF

RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    python3 /repo/fix_download_target_determiner_include.py /srcbuild

# BŁĄD ZŁAPANY DOPIERO NA LINKOWANIU (16. przypadek, 44137/44140 -- trzy
# cele od końca) -- TA SAMA rodzina co czwarty/dwunasty/trzynasty
# przypadek (wykluczenie `fix-building-without-safebrowsing.patch`
# zostawia osierocone pół-zmiany z INNYCH, aplikowanych patchy), ale
# pierwszy raz ujawniona przez LINKER, nie kompilator -- stąd długo
# niewidoczna (wszystkie 44140 obiektów kompiluje się bez błędu, bo
# nagłówek z deklaracjami wciąż istnieje). `remove-unused-preferences-
# fields.patch` zamienia CAŁY `static_library("safe_browsing_prefs")`
# (components/safe_browsing/core/common/BUILD.gn) na PUSTY
# `group("safe_browsing_prefs") { # SafeBrowsing prefs are disabled }`
# -- ten sam target NAME (więc GN nie zgłasza błędu "target not found"
# przy `gn gen`), ale bez `sources`, więc `safe_browsing_prefs.cc`
# (funkcje `GetSafeBrowsingState`, `EnableSafeBrowsingSettingSetLocallyPref`,
# `IsExtendedReportingEnabled`, `IsSafeBrowsingPolicyManaged`,
# `SetSafeBrowsingState`, `SetExtendedReportingPrefAndMetric`,
# `IsEnhancedProtectionEnabled`) NIGDY się nie kompiluje. Zamysł patcha:
# to bezpieczne, bo desktopowy `chrome/browser/safe_browsing/BUILD.gn`
# (przez WYKLUCZONY `fix-building-without-safebrowsing.patch`) miał
# przestać wołać te funkcje -- ale `chrome/browser/safe_browsing/
# android/BUILD.gn` (JNI bridge `safe_browsing_bridge.cc`, ANDROID-only,
# nietknięty przez ŻADEN patch) nadal ma `deps = [".../core/common:
# safe_browsing_prefs"]` i realnie woła te funkcje -> `undefined symbol`
# na linkerze, nie w kompilacji pojedynczych plików. Zweryfikowane
# host-side: `safe_browsing_prefs.cc`/`.h` (przycięte przez TEN SAM
# patch o usunięte stałe kSafeBrowsing*, ale wciąż zawierające te 7
# funkcji) nie są dotknięte przez żaden INNY patch -- wystarczy
# przywrócić SAM target w BUILD.gn, nie treść pliku.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cat > /repo/fix_safe_browsing_prefs_target.py <<'PYEOF'
#!/usr/bin/env python3
"""remove-unused-preferences-fields.patch zamienia static_library
"safe_browsing_prefs" na pusty group() o tej samej nazwie -- bezpieczne
na desktopie (wykluczony fix-building-without-safebrowsing.patch mial
usunac wolajacych), ale chrome/browser/safe_browsing/android/BUILD.gn
(nietkniety przez zaden patch) nadal go potrzebuje. Przywracamy tylko
target w BUILD.gn, nie ruszamy tresci .cc/.h (przyciete poprawnie przez
ten sam patch, funkcje ktorych Android potrzebuje tam zostaly)."""
import sys
from pathlib import Path

SRC = Path(sys.argv[1] if len(sys.argv) > 1 else "/srcbuild")
f = SRC / "components/safe_browsing/core/common/BUILD.gn"
text = f.read_text()
old = '''group("safe_browsing_prefs") {
  # SafeBrowsing prefs are disabled
}'''
count = text.count(old)
new = '''static_library("safe_browsing_prefs") {
  sources = [
    "safe_browsing_prefs.cc",
    "safe_browsing_prefs.h",
  ]

  configs += [ "//build/config/compiler:wexit_time_destructors" ]

  deps = [
    ":features",
    "//components/pref_registry",
    "//components/prefs",
    "//net",
  ]

  public_deps = [ "//base" ]
}'''
if count == 0:
    assert new in text, "ani stary group(), ani nowy static_library() nie znaleziony -- nieoczekiwany stan pliku"
    print("static_library(\"safe_browsing_prefs\") juz przywrocony, pomijam")
else:
    assert count == 1, f"oczekiwano 1 wystapienia, znaleziono {count}"
    f.write_text(text.replace(old, new))
    print("static_library(\"safe_browsing_prefs\") przywrocony w core/common/BUILD.gn")
PYEOF

RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    python3 /repo/fix_safe_browsing_prefs_target.py /srcbuild

# BŁĄD PRZEWIDZIANY PRZED NINJA (156.0.8078.47, 2026-10-26 -- wzorzec:
# wykluczenie patcha osiera połowę zmiany). Upstream po 151
# przemianował V4LocalDatabaseManager na SBLocalDatabaseManager i dodał
# PUBLICZNY konstruktor z `base::PassKey`, którego używa `Create()`.
# Stosowany `remove-unused-preferences-fields.patch` usuwa
# `ExtendedReportingLevelCallback` z `Create()`, prywatnego konstruktora,
# pola i aliasu typu (v4_update_protocol_manager.h), ale ten sam parametr
# w konstruktorze z PassKey usuwa wyłącznie WYKLUCZONY
# `fix-building-without-safebrowsing.patch`. Bez poprawki nagłówek
# odwołuje się do nieistniejącego typu, a `Create()` podaje 5 argumentów
# do 6-parametrowego konstruktora. Android buduje ten target bezwarunkowo
# (chrome/browser/safe_browsing/BUILD.gn -> sb_local_database_manager).
# Fix = dokładnie dwa hunki z wykluczonego patcha. Zweryfikowane na
# drzewie 156 po pełnej serii patchy (symulacja host-side): drugi przebieg
# niczego nie zmienia, zero referencji do usuniętego parametru.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cat > /repo/fix_sb_local_database_manager_passkey_ctor.py <<'PYEOF'
#!/usr/bin/env python3
"""remove-unused-preferences-fields.patch (156) usuwa ExtendedReportingLevelCallback
z SBLocalDatabaseManager::Create() i z PRYWATNEGO konstruktora, ale ten sam
parametr w PUBLICZNYM konstruktorze z PassKey (dodany upstream po 151, uzywany
przez Create() i testy) usuwa dopiero WYKLUCZONY fix-building-without-
safebrowsing.patch. Bez tego sb_local_database_manager.cc sie nie kompiluje
(Create() podaje 5 argumentow do 6-parametrowego ctora; ctor z PassKey deleguje
5 argumentow do 4-parametrowego). Na Androidzie target jest budowany
bezwarunkowo (chrome/browser/safe_browsing/BUILD.gn, deps static_library
"safe_browsing"). Fix = dokladnie dwa hunki z wykluczonego patcha."""
import sys
from pathlib import Path

SRC = Path(sys.argv[1] if len(sys.argv) > 1 else "/srcbuild")
d = SRC / "components/safe_browsing/core/browser/db"

h = d / "sb_local_database_manager.h"
th = h.read_text()
old_h = """      base::PassKey<SBLocalDatabaseManager, SBLocalDatabaseManagerTest>,
      const base::FilePath& base_path,
      ExtendedReportingLevelCallback extended_reporting_level_callback,
      scoped_refptr<base::SequencedTaskRunner> ui_task_runner,"""
new_h = """      base::PassKey<SBLocalDatabaseManager, SBLocalDatabaseManagerTest>,
      const base::FilePath& base_path,
      scoped_refptr<base::SequencedTaskRunner> ui_task_runner,"""
if new_h in th and old_h not in th:
    print("sb_local_database_manager.h: juz poprawiony, pomijam")
else:
    assert th.count(old_h) == 1, f".h: oczekiwano 1, znaleziono {th.count(old_h)}"
    h.write_text(th.replace(old_h, new_h))
    print("sb_local_database_manager.h: parametr usuniety z ctora PassKey")

c = d / "sb_local_database_manager.cc"
tc = c.read_text()
old_c = """    base::PassKey<SBLocalDatabaseManager, SBLocalDatabaseManagerTest>,
    const base::FilePath& base_path,
    ExtendedReportingLevelCallback extended_reporting_level_callback,
    scoped_refptr<base::SequencedTaskRunner> ui_task_runner,
    scoped_refptr<base::SequencedTaskRunner> io_task_runner,
    scoped_refptr<base::SequencedTaskRunner> task_runner_for_tests)
    : SBLocalDatabaseManager(base_path,
                             extended_reporting_level_callback,
                             std::move(ui_task_runner),"""
new_c = """    base::PassKey<SBLocalDatabaseManager, SBLocalDatabaseManagerTest>,
    const base::FilePath& base_path,
    scoped_refptr<base::SequencedTaskRunner> ui_task_runner,
    scoped_refptr<base::SequencedTaskRunner> io_task_runner,
    scoped_refptr<base::SequencedTaskRunner> task_runner_for_tests)
    : SBLocalDatabaseManager(base_path,
                             std::move(ui_task_runner),"""
if new_c in tc and old_c not in tc:
    print("sb_local_database_manager.cc: juz poprawiony, pomijam")
else:
    assert tc.count(old_c) == 1, f".cc: oczekiwano 1, znaleziono {tc.count(old_c)}"
    c.write_text(tc.replace(old_c, new_c))
    print("sb_local_database_manager.cc: ctor PassKey + delegacja poprawione")

for f in (h, c):
    assert "extended_reporting_level_callback" not in f.read_text(), f"{f.name}: zostala referencja"
print("sb_local_database_manager: spojne (zero extended_reporting_level_callback)")
PYEOF

RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    python3 /repo/fix_sb_local_database_manager_passkey_ctor.py /srcbuild

# BŁĄD ZŁAPANY W NINJA (17. przypadek, DOPIERO teraz -- ten plik nigdy
# wcześniej się nie kompilował, dopóki poprzedni fix nie przywrócił
# targetu z pustego group()). `safe_browsing_prefs.cc:RegisterProfilePrefs`
# (kod NIEDOTKNIĘTY przez żaden patch -- to własny, wewnętrzny call site
# tego samego pliku, którego .h dotyczył jedenasty przypadek) woła
# `prefs::kJavascriptOptimizerBlockedForUnfamiliarSites` bez kwalifikacji
# `::` -- to PIERWOTNIE (pristine) rozwiązywało się do
# `safe_browsing::prefs::...` (deklaracja we WŁASNYM `safe_browsing_
# prefs.h`, usunięta przez fix jedenastego przypadku jako "duplikat").
# Ale C++ nie szuka INNEJ, globalnej przestrzeni `prefs` o tej samej
# nazwie, gdy `safe_browsing::prefs` już istnieje (ma inne stałe, np.
# `kMigratedToJavascriptOptimizerBlockedForUnfamiliarSites` -- stąd
# `error: no member ... did you mean 'kMigratedTo...'`, kompilator
# poprawnie znalazł przestrzeń nazw, tylko nie ten jeden człon).
# `move-js-optimizer-unfamiliar-sites.patch` inne wywołania (generated_
# javascript_optimizer_pref.cc, site_familiarity_utils.cc,
# content_settings_pref_provider.cc) jawnie kwalifikuje `::prefs::` LUB
# dokłada `#include ".../content_settings/core/common/pref_names.h"` --
# ten JEDEN wewnętrzny call site w safe_browsing_prefs.cc, którego patch
# nie dotyka wcale, tego nie dostał. Linia bezpośrednio nad nim w TEJ
# SAMEJ funkcji już ma wzorzec `::prefs::kBundledSettings...` (jawna
# globalna kwalifikacja) -- ten sam fix, zastosowany konsekwentnie.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cat > /repo/fix_safe_browsing_prefs_cc_js_optimizer.py <<'PYEOF'
#!/usr/bin/env python3
"""safe_browsing_prefs.cc:RegisterProfilePrefs wola nieskwalifikowane
prefs::kJavascriptOptimizerBlockedForUnfamiliarSites -- rozwiazuje sie do
safe_browsing::prefs (wlasny, zagniezdzony namespace), gdzie tej stalej
juz nie ma (przeniesiona przez move-js-optimizer-unfamiliar-sites.patch
do globalnego content_settings/core/common/pref_names.h). Fix: jawna
kwalifikacja ::prefs:: (jak linia wyzej w tej samej funkcji) + include."""
import sys
from pathlib import Path

SRC = Path(sys.argv[1] if len(sys.argv) > 1 else "/srcbuild")
f = SRC / "components/safe_browsing/core/common/safe_browsing_prefs.cc"
text = f.read_text()

old_call = "      prefs::kJavascriptOptimizerBlockedForUnfamiliarSites, false);"
new_call = "      ::prefs::kJavascriptOptimizerBlockedForUnfamiliarSites, false);"
if new_call in text:
    print("wywolanie juz zakwalifikowane ::prefs::, pomijam")
else:
    assert text.count(old_call) == 1, f"oczekiwano 1, znaleziono {text.count(old_call)}"
    text = text.replace(old_call, new_call)

include_line = '#include "components/content_settings/core/common/pref_names.h"\n'
if include_line in text:
    print("include content_settings/pref_names.h juz obecny, pomijam")
else:
    anchor = '#include "components/pref_registry/pref_registry_syncable.h"\n'
    assert text.count(anchor) == 1, f"oczekiwano 1 zakotwiczenia include, znaleziono {text.count(anchor)}"
    text = text.replace(anchor, anchor + include_line)

f.write_text(text)
print("safe_browsing_prefs.cc: ::prefs:: kwalifikacja + include gotowe")
PYEOF

RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
