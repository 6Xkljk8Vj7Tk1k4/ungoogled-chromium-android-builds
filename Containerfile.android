# BŁĄD ZŁAPANY NA URZĄDZENIU (20. przypadek, TRZECI crash z rzędu w tym
# samym obszarze -- signin) -- ekran powitalny (FullscreenSigninMediator,
# pierwsze uruchomienie) crashuje w `isSigninSupported()`:
# `UserPrefs.get(profile).getBoolean(Pref.SIGNIN_ALLOWED)` -> `CHECK` fail
# w `PrefService::GetPreferenceValue` (ten sam wzorzec błędu co 18/19,
# inny pref). Zdiagnozowane BEZ kolejnego zgadywania z samego C++ stosu:
# `Java_J_N_ZJO` w tombstone nie mówi WIELE (generyczne `PrefService.
# getBoolean(String)`, klucz jako runtime string), więc wyciągnięty
# `ChromePublic.apk.mapping` (R8/ProGuard, też żyje na `/srcbuild`) do
# deobfuskacji zminifikowanych klas Javy (`lp5`/`hp5`) na prawdziwe nazwy
# (`FullscreenSigninMediator.onInitialLoadCompleted` ->
# `isSigninSupported` -> `getTitleText`) -- BEZ tego namierzenie
# konkretnego wywołania w zaciemnionym kodzie R8 byłoby zgadywaniem.
#
# Przyczyna: DOKŁADNIE ten sam wzorzec co osiemnasty/dziewiętnasty
# przypadek, TRZECIA już ofiara `remove-unused-preferences-fields.patch`
# w podsystemie signin -- `PrimaryAccountManager::RegisterProfilePrefs`
# (osobna, statyczna funkcja w TYM SAMYM pliku co dziewiętnasty przypadek)
# wycięta do PUSTEGO ciała (`{}`), razem z `#include ".../signin_pref_
# names.h"` (usunięty jako "nieużywany" -- prawda, dopóki funkcja jest
# pusta). Pristine rejestrowała 11 prefów w tej funkcji (m.in. `kGoogle
# ServicesLastSyncingGaiaId`, `kExplicitBrowserSignin`) -- większość z
# nich dotyczy PRZYWRACANIA poprzedniej sesji/synchronizacji, celowo
# niepotrzebne (spójne z duchem patcha i dziewiętnastym przypadkiem).
# TYLKO `kSigninAllowed` jest faktycznie CZYTANE poza tym plikiem (przez
# UI pierwszego uruchomienia, sprawdzające czy w ogóle POKAZAĆ ekran
# logowania) -- i to jedyne, co przywracamy, RAZEM Z WŁASNĄ WARTOŚCIĄ
# `false` (nie `true` jak pristine) -- to dokładnie ten sam literał, co
# istniał w tej sesji PRZED przejściem na pełną serię patchy (dawna
# tabela: "Logowanie do konta ... kSigninAllowed, true ->
# false"), teraz wpisany wprost zamiast przez `install_android.sh`.
# Zweryfikowane host-side na w pełni załatanym drzewie (pełny reset +
# reaplikacja 106 patchy PRZED testem, konsekwentnie jak w 18/19).
#
# OTWARTE: skoro to już TRZECI taki przypadek w JEDNYM pliku (dwie
# funkcje: konstruktor w 19., ta funkcja w 20.), możliwe że są kolejne w
# INNYCH plikach dotkniętych tym samym patchem -- ten patch dotyka
# dziesiątek plików w wielu subsystemach (safe_browsing, signin, i
# zapewne więcej), a każdy taki przypadek ujawnia się DOPIERO na
# urządzeniu, nigdy w buildzie. Nie ma jak wyczerpująco to sprawdzić bez
# testowania każdej ścieżki UI na żywym urządzeniu.
RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
    if [ "${VARIANT}" != "ungoogled" ]; then exit 0; fi; \
    cat > /repo/fix_primary_account_manager_register_prefs.py <<'PYEOF'
#!/usr/bin/env python3
"""remove-unused-preferences-fields.patch wycina cale cialo
PrimaryAccountManager::RegisterProfilePrefs (+ include signin_pref_names.h)
-- wiekszosc z 11 usunietych prefow to celowo niepotrzebne przywracanie
sesji, ale kSigninAllowed jest czytane przez FRE UI (isSigninSupported) i
musi byc zarejestrowane, inaczej CHECK-crash. Przywracamy WYLACZNIE ten
jeden pref, z wartoscia false (nasza polityka prywatnosci, nie pristine
true)."""
import sys
from pathlib import Path

SRC = Path(sys.argv[1] if len(sys.argv) > 1 else "/srcbuild")
f = SRC / "components/signin/internal/identity_manager/primary_account_manager.cc"
text = f.read_text()

include_line = '#include "components/signin/public/base/signin_pref_names.h"\n'
if include_line in text:
    print("include signin_pref_names.h juz obecny, pomijam")
else:
    anchor_inc = '#include "components/signin/public/base/signin_prefs.h"\n'
    assert text.count(anchor_inc) == 1, f"oczekiwano 1 zakotwiczenia include, znaleziono {text.count(anchor_inc)}"
    text = text.replace(anchor_inc, anchor_inc + include_line)

new_marker = "registry->RegisterBooleanPref(prefs::kSigninAllowed, false);\n"
if new_marker in text:
    print("rejestracja kSigninAllowed juz obecna, pomijam")
else:
    old = """void PrimaryAccountManager::RegisterProfilePrefs(PrefRegistrySimple* registry) {
}"""
    new = """void PrimaryAccountManager::RegisterProfilePrefs(PrefRegistrySimple* registry) {
  registry->RegisterBooleanPref(prefs::kSigninAllowed, false);
}"""
    count = text.count(old)
    assert count == 1, f"oczekiwano 1, znaleziono {count}"
    text = text.replace(old, new)

f.write_text(text)
print("primary_account_manager.cc: kSigninAllowed=false zarejestrowany")
PYEOF

RUN --mount=type=cache,target=/srcbuild,id=chromium-src-android-hardened \
